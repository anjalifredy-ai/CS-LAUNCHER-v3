<?xml version="1.0" encoding="utf-8"?>
<!--
  CS Launcher Plus styles.
  IMPORTANT: Do NOT use dotted style names like CS.Text.Pixel — AAPT requires
  parent style CS, CS.Text, etc. Use underscores instead.
-->
<resources>

    <!-- Root marker (in case any leftover dotted name still exists elsewhere) -->
    <style name="CS" />

    <style name="Theme.CSLauncher" parent="@style/Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cs_brand_green</item>
        <item name="colorOnPrimary">@color/cs_bg_pure_black</item>
        <item name="colorSecondary">@color/cs_brand_purple</item>
        <item name="colorOnSecondary">@color/cs_text_primary</item>
        <item name="android:windowBackground">@color/cs_bg_pure_black</item>
        <item name="android:statusBarColor">@color/cs_bg_pure_black</item>
        <item name="android:navigationBarColor">@color/cs_bg_surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="CS_Text">
        <item name="android:textColor">@color/cs_text_primary</item>
    </style>

    <style name="CS_Text_SectionLabel" parent="CS_Text">
        <item name="android:textColor">@color/cs_text_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="CS_Text_Pixel" parent="CS_Text">
        <item name="android:textColor">@color/cs_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CS_Text_CardTitle" parent="CS_Text">
        <item name="android:textColor">@color/cs_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CS_Text_CardSub" parent="CS_Text">
        <item name="android:textColor">@color/cs_text_secondary</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="CS_Card" />
    <style name="CS_Button" />
    <style name="CS_Chip" />

</resources>
