<?xml version="1.0" encoding="utf-8"?>
<!-- PREMIUM V4 — Download Console: floating glass command deck
     Layered depth: ambient shadow + dark gradient face + platinum rim + top glass hairline + inner glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. soft ambient shadow (lift) -->
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#26000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- 2. main face: graphite → near-black gradient -->
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#21232B"
                android:centerColor="#1A1C23"
                android:endColor="#121318"
                android:type="linear" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.1dp"
                android:color="#2E303B" />
        </shape>
    </item>
    <!-- 3. inner platinum rim (1dp inset) -->
    <item
        android:bottom="4dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="23dp" />
            <stroke
                android:width="0.8dp"
                android:color="#12FFFFFF" />
        </shape>
    </item>
    <!-- 4. top glass hairline (specular) -->
    <item
        android:bottom="4dp"
        android:gravity="top"
        android:height="1.2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#33FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#00FFFFFF"
                android:type="linear" />
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
        </shape>
    </item>
</layer-list>
