<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1C1D24" />
            <corners android:radius="16dp" />
            <stroke android:width="1.4dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:left="1.4dp" android:top="1.4dp" android:right="1.4dp" android:bottom="1.4dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="14dp" />
            <stroke android:width="0.8dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>
