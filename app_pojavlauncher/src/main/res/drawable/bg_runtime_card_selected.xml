<?xml version="1.0" encoding="utf-8"?>
<!-- SHARED PREMIUM CARD — selected (shared runtime/jar) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#252A36"
                android:centerColor="#1E2432"
                android:endColor="#1A1E2B"
                android:type="linear" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1.4dp"
                android:color="#7BE8E0" />
        </shape>
    </item>
    <!-- inner soft glow -->
    <item
        android:bottom="1.2dp"
        android:left="1.2dp"
        android:right="1.2dp"
        android:top="1.2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#227BE8E0" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="1.2dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners
                android:topLeftRadius="18dp"
                android:topRightRadius="18dp" />
        </shape>
    </item>
</layer-list>
