<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback beam for non-custom ProgressBars — luminous pill track + gradient fill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#1E2129" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#2A2E38" />
                <corners android:radius="999dp" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <layer-list>
                <item
                    android:bottom="-2dp"
                    android:left="-2dp"
                    android:right="-2dp"
                    android:top="-2dp">
                    <shape android:shape="rectangle">
                        <gradient
                            android:angle="0"
                            android:centerColor="#E6EEF2"
                            android:endColor="#FFFFFF"
                            android:startColor="#8BE8E0" />
                        <corners android:radius="999dp" />
                    </shape>
                </item>
                <item
                    android:bottom="1.2dp"
                    android:top="1.2dp">
                    <shape android:shape="rectangle">
                        <solid android:color="#55FFFFFF" />
                        <corners android:radius="999dp" />
                    </shape>
                </item>
            </layer-list>
        </clip>
    </item>
</layer-list>
