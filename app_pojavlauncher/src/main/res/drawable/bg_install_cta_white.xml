<?xml version="1.0" encoding="utf-8"?>
<!-- PREMIUM HIGH-CONTRAST CTA — white-to-ice gradient with teal rim, bold elevation -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#2A2D36" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#1F242E" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#E6F0F2"
                android:endColor="#C8EDEF"
                android:startColor="#F2F8F9"
                android:type="linear" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1.2dp"
                android:color="#7BE8E0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#F5F7F9"
                android:endColor="#E8F0F2"
                android:startColor="#FFFFFF"
                android:type="linear" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#7BE8E0" />
        </shape>
    </item>
</selector>
