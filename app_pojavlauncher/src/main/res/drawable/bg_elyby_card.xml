<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#1E000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1F202A"
                android:centerColor="#181A24"
                android:endColor="#14151D"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#2A2E40" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:gravity="top"
        android:height="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="#28FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#00FFFFFF"
                android:type="linear" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
        </shape>
    </item>
</layer-list>
