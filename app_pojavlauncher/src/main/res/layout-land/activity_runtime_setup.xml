<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_csc_screen">
 <LinearLayout android:id="@+id/rs_select_container" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:background="@drawable/bg_csc_panel" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp"><FrameLayout android:id="@+id/rs_brand_orbit" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_csc_icon"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="J" android:textColor="#F2F3F5" android:textSize="19sp" android:textStyle="bold"/></FrameLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="11dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RUNTIME MATRIX" android:textColor="#F2F3F5" android:textSize="17sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SELECT JAVA ENGINES • VERIFIED AND ISOLATED" android:textColor="#7F8994" android:textSize="7sp"/></LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="26dp" android:background="@drawable/bg_account_badge" android:gravity="center" android:paddingHorizontal="10dp" android:text="DEVICE COMPATIBLE" android:textColor="#9FD6AC" android:textSize="7sp" android:textStyle="bold"/></LinearLayout>
  <TextView android:id="@+id/rs_offline_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:background="@drawable/bg_runtime_forge_offline" android:padding="7dp" android:text="@string/rs_offline_note" android:textColor="#E6A6AB" android:textSize="8sp" android:visibility="gone"/>
  <GridLayout android:id="@+id/rs_card_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="7dp" android:layout_weight="1" android:columnCount="2" android:rowCount="2"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="7dp" android:background="@drawable/bg_csc_panel" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="10dp"><TextView android:id="@+id/rs_btn_skip" android:layout_width="120dp" android:layout_height="36dp" android:background="@drawable/bg_csc_outline_button" android:gravity="center" android:text="@string/rs_skip" android:textColor="#BCC3CC" android:textSize="9sp" android:textStyle="bold"/><Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/><TextView android:id="@+id/rs_btn_install" android:layout_width="240dp" android:layout_height="38dp" android:background="@drawable/bg_csc_primary_button" android:gravity="center" android:text="@string/rs_install_cta" android:textColor="#101419" android:textSize="10sp" android:textStyle="bold"/></LinearLayout>
 </LinearLayout>
 <LinearLayout android:id="@+id/rs_install_container" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:visibility="gone" tools:visibility="visible">
  <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:background="@drawable/bg_csc_panel" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PARALLEL RUNTIME ASSEMBLY" android:textColor="#F2F3F5" android:textSize="17sp" android:textStyle="bold"/><TextView android:id="@+id/rs_overall_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="8dp" android:layout_weight="1" android:orientation="horizontal"><LinearLayout android:layout_width="220dp" android:layout_height="match_parent" android:background="@drawable/bg_csc_panel" android:gravity="center" android:orientation="vertical" android:padding="12dp"><FrameLayout android:layout_width="126dp" android:layout_height="126dp"><View android:id="@+id/rs_ring_halo" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_runtime_forge_halo"/><net.kdt.pojavlaunch.multirt.RuntimeRingView android:id="@+id/rs_ring" android:layout_width="match_parent" android:layout_height="match_parent"/></FrameLayout><TextView android:id="@+id/rs_overall_step" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="#F2F3F5" android:textSize="11sp" android:textStyle="bold"/><TextView android:id="@+id/rs_status_line" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:textColor="#7F8994" android:textSize="8sp"/></LinearLayout><ScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:overScrollMode="never" android:scrollbars="none"><LinearLayout android:id="@+id/rs_install_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/></ScrollView></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_csc_panel" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="10dp"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PARALLEL DOWNLOAD • SAFE SEQUENTIAL INSTALL" android:textColor="#707B86" android:textSize="7sp" android:textStyle="bold"/><TextView android:id="@+id/rs_btn_done" android:layout_width="230dp" android:layout_height="38dp" android:background="@drawable/bg_csc_primary_button" android:gravity="center" android:text="@string/rs_done_cta" android:textColor="#101419" android:textSize="10sp" android:textStyle="bold" android:visibility="gone" tools:visibility="visible"/></LinearLayout>
 </LinearLayout>
</FrameLayout>