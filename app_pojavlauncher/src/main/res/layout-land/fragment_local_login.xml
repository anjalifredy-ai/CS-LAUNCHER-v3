<?xml version="1.0" encoding="utf-8"?>
<!-- Remom offline account — landscape, same IDs -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_launcher_dark"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight=".42"
        android:background="@drawable/bg_auth_card_dark"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="18dp">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_auth_offline"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="REMOM · OFFLINE"
            android:textColor="@color/accent_light"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_csc_icon">
            <ImageView
                android:id="@+id/live_head_preview"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <View
                android:id="@+id/auth_status_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_status_dot" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="NO PASSWORD · LOCAL ONLY"
                android:textColor="@color/text_secondary_light"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight=".58"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_auth_card_dark"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CREATE OFFLINE ACCOUNT"
                android:textColor="@color/text_primary_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Username for local worlds and offline-mode servers."
                android:textColor="@color/text_secondary_dim"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="USERNAME"
                android:textColor="@color/accent_light"
                android:textSize="9sp"
                android:textStyle="bold" />

            <com.kdt.mcgui.MineEditText
                android:id="@+id/login_edit_email"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_auth_input_box"
                android:hint="3–16 characters"
                android:paddingHorizontal="15dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#4F5961" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="A–Z, 0–9 and underscore only\nNo password stored · premium servers need Microsoft"
                android:textColor="@color/text_secondary_dim"
                android:textSize="8sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:id="@+id/login_button"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_auth_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="CREATE ACCOUNT"
                android:textColor="@color/play_btn_text"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
