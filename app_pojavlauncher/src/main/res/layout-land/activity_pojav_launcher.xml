<?xml version="1.0" encoding="utf-8"?>
<!-- RemomLauncher — unique header (not CS/Nexus clone) -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="#0A1628">

    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:background="@drawable/bg_remom_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_launcher_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REMOM"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#3B9EFF"
            android:letterSpacing="0.12"
            android:paddingEnd="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LAUNCHER"
            android:textSize="11sp"
            android:textColor="#7A9BB8"
            android:letterSpacing="0.08"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:id="@+id/edition_switch_bar"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_remom_tile"
            android:padding="3dp">
            <TextView
                android:id="@+id/btn_edition_java"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="JAVA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#0A1628"
                android:background="@drawable/bg_remom_pill_on"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/btn_edition_bedrock"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_marginStart="2dp"
                android:text="BEDROCK"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#C8D8EC"
                android:background="@drawable/bg_remom_pill_off"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <Spinner
            android:id="@+id/edition_spinner"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/nav_mod_store"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_marginEnd="6dp"
            android:text="Mods"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#B8D0EC"
            android:background="@drawable/bg_remom_tile"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/nav_home"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_marginEnd="8dp"
            android:text="Home"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#0A1628"
            android:background="@drawable/bg_remom_pill_on"
            android:clickable="true"
            android:focusable="true" />

        <com.kdt.mcgui.mcAccountSpinner
            android:id="@+id/account_spinner"
            android:layout_width="168dp"
            android:layout_height="40dp"
            android:dropDownWidth="260dp"
            android:dropDownVerticalOffset="40dp"
            android:popupBackground="@drawable/bg_account_popup"
            android:popupElevation="10dp"
            android:background="@drawable/bg_remom_tile"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

        <ImageButton
            android:id="@+id/setting_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_remom_tile"
            android:src="@drawable/ic_menu_settings"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="Settings" />

        <FrameLayout android:id="@+id/btn_home_logo" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone">
            <ImageView android:id="@+id/iv_cs_logo" android:layout_width="0dp" android:layout_height="0dp" />
        </FrameLayout>
        <View android:id="@+id/nav_home_indicator" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <View android:id="@+id/nav_mod_store_indicator" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <FrameLayout android:id="@+id/nav_custom_controls" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <FrameLayout android:id="@+id/nav_cursor" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <FrameLayout android:id="@+id/nav_skin" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/header_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="6dp" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/header_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
