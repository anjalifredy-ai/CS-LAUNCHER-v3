<?xml version="1.0" encoding="utf-8"?>
<!-- RemomLauncher landscape shell — same IDs/paths as CS, Remom look -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="@color/bg_launcher_dark">

    <!-- TOP BAR: Logo + Title + Nav + Account + Settings (same button IDs) -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_52sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_10sdp"
        android:paddingEnd="@dimen/_8sdp"
        android:background="@drawable/bg_header_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/btn_home_logo"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <ImageView
                android:id="@+id/iv_cs_logo"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_gravity="center"
                android:src="@mipmap/ic_launcher_round"
                android:scaleType="fitCenter"
                android:contentDescription="RemomLauncher" />

        </FrameLayout>

        <TextView
            android:id="@+id/tv_launcher_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:text="@string/cs_launcher_title"
            android:textSize="@dimen/_14ssp"
            android:fontFamily="@font/minecraftia"
            android:includeFontPadding="false"
            android:textStyle="bold"
            android:textColor="@color/accent_primary"
            android:letterSpacing="0.04"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="@dimen/_6sdp"
            android:paddingVertical="@dimen/_4sdp" />

        <FrameLayout
            android:id="@+id/nav_mod_store"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/nav_mod_store_icon"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_download_box"
                    android:contentDescription="@string/mcl_button_mod_store" />
                <View
                    android:id="@+id/nav_mod_store_indicator"
                    android:layout_width="14dp"
                    android:layout_height="2dp"
                    android:background="@color/accent_primary"
                    android:visibility="invisible" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_custom_controls"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/nav_controls_icon"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_menu_custom_controls"
                    android:contentDescription="@string/mcl_option_customcontrol" />
                <View
                    android:id="@+id/nav_controls_indicator"
                    android:layout_width="14dp"
                    android:layout_height="2dp"
                    android:background="@color/accent_primary"
                    android:visibility="invisible" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_cursor"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/nav_cursor_icon"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_mouse_pointer"
                    android:contentDescription="@string/cursor_customization_title" />
                <View
                    android:id="@+id/nav_cursor_indicator"
                    android:layout_width="14dp"
                    android:layout_height="2dp"
                    android:background="@color/accent_primary"
                    android:visibility="invisible" />
            </LinearLayout>
        </FrameLayout>

        <ImageButton
            android:id="@+id/btn_about"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginHorizontal="@dimen/_4sdp"
            android:layout_gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/cs_about_title"
            android:padding="@dimen/_7sdp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_info" />

        <FrameLayout
            android:id="@+id/nav_skin"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/nav_skin_icon"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_manage_skin"
                    android:contentDescription="Manage Skin" />
                <View
                    android:id="@+id/nav_skin_indicator"
                    android:layout_width="14dp"
                    android:layout_height="2dp"
                    android:background="@color/accent_primary"
                    android:visibility="invisible" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/nav_home"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/nav_home_icon"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_home"
                    android:contentDescription="@string/mcl_tab_home" />
                <View
                    android:id="@+id/nav_home_indicator"
                    android:layout_width="14dp"
                    android:layout_height="2dp"
                    android:background="@color/accent_primary"
                    android:visibility="visible" />
            </LinearLayout>
        </FrameLayout>

        <!-- Account (KEEP) -->
        <com.kdt.mcgui.mcAccountSpinner
            android:id="@+id/account_spinner"
            android:layout_width="190dp"
            android:layout_height="44dp"
            android:dropDownWidth="280dp"
            android:dropDownVerticalOffset="@dimen/_40sdp"
            android:popupBackground="@drawable/bg_account_popup"
            android:popupElevation="10dp"
            android:background="@drawable/bg_account_spinner"
            android:paddingStart="@dimen/_6sdp"
            android:paddingEnd="@dimen/_6sdp" />

        <ImageButton
            android:id="@+id/setting_button"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:background="@drawable/bg_settings_btn"
            android:src="@drawable/ic_menu_settings"
            android:scaleType="fitCenter"
            android:padding="@dimen/_7sdp"
            android:contentDescription="Settings"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/header_bar"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:layout_marginStart="@dimen/padding_large"
        android:layout_marginEnd="@dimen/padding_large"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/header_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
