<?xml version="1.0" encoding="utf-8"?>
<!-- RemomLauncher landscape shell — Java/Bedrock edition switch -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="@color/bg_launcher_dark">

    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_52sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_10sdp"
        android:paddingEnd="@dimen/_8sdp"
        android:background="@drawable/bg_header_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/btn_home_logo"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/iv_cs_logo"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_gravity="center"
                android:src="@mipmap/ic_launcher_round"
                android:scaleType="fitCenter"
                android:contentDescription="RemomLauncher" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_launcher_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:text="RemomLauncher"
            android:textSize="@dimen/_14ssp"
            android:fontFamily="@font/minecraftia"
            android:includeFontPadding="false"
            android:textStyle="bold"
            android:textColor="@color/accent_primary"
            android:letterSpacing="0.04" />

        <!-- Visible Java | Bedrock switch -->
        <LinearLayout
            android:id="@+id/edition_switch_bar"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_36sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_account_spinner"
            android:padding="3dp">
            <TextView
                android:id="@+id/btn_edition_java"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="Java"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#151518"
                android:background="@drawable/bg_cs_tab_pill_active"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/btn_edition_bedrock"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_marginStart="2dp"
                android:text="Bedrock"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#E8E8EC"
                android:background="@drawable/bg_cs_tab_pill_idle"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <Spinner
            android:id="@+id/edition_spinner"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/nav_home"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/ic_home"
                    android:contentDescription="@string/mcl_tab_home" />
                <View
                    android:id="@+id/nav_home_indicator"
                    android:layout_width="14dp"
                    android:layout_height="2dp"
                    android:background="@color/accent_primary"
                    android:visibility="visible" />
            </LinearLayout>
        </FrameLayout>

        <com.kdt.mcgui.mcAccountSpinner
            android:id="@+id/account_spinner"
            android:layout_width="190dp"
            android:layout_height="44dp"
            android:dropDownWidth="280dp"
            android:dropDownVerticalOffset="@dimen/_40sdp"
            android:popupBackground="@drawable/bg_account_popup"
            android:popupElevation="10dp"
            android:background="@drawable/bg_account_spinner"
            android:paddingStart="@dimen/_6sdp"
            android:paddingEnd="@dimen/_6sdp" />

        <ImageButton
            android:id="@+id/setting_button"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:background="@drawable/bg_settings_btn"
            android:src="@drawable/ic_menu_settings"
            android:scaleType="fitCenter"
            android:padding="@dimen/_7sdp"
            android:contentDescription="Settings"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/header_bar"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        android:layout_marginStart="@dimen/padding_large"
        android:layout_marginEnd="@dimen/padding_large"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/header_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
