<?xml version="1.0" encoding="utf-8"?>
<!-- PREMIUM V4 — Runtime Wizard Dialog (shared system) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_install_page"
    android:paddingHorizontal="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_deck_icon_tile">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_java_cup"
                android:tint="#7BE8E0" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_runtime_chip_recommended"
                android:letterSpacing="0.12"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="@string/rw_eyebrow"
                android:textColor="#D8C79A"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/rw_title"
                android:textColor="#F0F0F3"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/rw_sub"
        android:textColor="#9C9CA8"
        android:textSize="11.5sp" />

    <TextView
        android:id="@+id/rw_status_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_runtime_chip_neutral"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="#D8C79A"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Setting up runtimes (1/2) — keep the app open"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <include
            layout="@layout/item_runtime_choice_h"
            android:id="@+id/rw_card_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp" />

        <include
            layout="@layout/item_runtime_choice_h"
            android:id="@+id/rw_card_17"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp" />

        <include
            layout="@layout/item_runtime_choice_h"
            android:id="@+id/rw_card_21"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp" />

        <include
            layout="@layout/item_runtime_choice_h"
            android:id="@+id/rw_card_25"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rw_btn_skip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_browse_filter_btn"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/rw_skip"
            android:textAllCaps="false"
            android:textColor="#9C9CA8"
            android:textSize="12.5sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/rw_btn_action"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2.1"
            android:background="@drawable/bg_install_cta_white"
            android:elevation="2dp"
            android:gravity="center"
            android:text="@string/rw_download_cta_none"
            android:textAllCaps="false"
            android:textColor="#0E0E11"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
