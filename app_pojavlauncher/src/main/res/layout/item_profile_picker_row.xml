<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_remom_tile"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/pp_row_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_deck_icon_tile"
        android:gravity="center"
        android:text="◆"
        android:textColor="#3B9EFF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pp_row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F0F6FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/pp_row_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#7A9BB8"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/pp_row_active"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_remom_play"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:text="ACTIVE"
        android:textColor="#0A1628"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/pp_row_edit"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="✎"
        android:textColor="#8AB4D8"
        android:textSize="14sp"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
