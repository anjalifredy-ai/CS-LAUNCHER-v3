<?xml version="1.0" encoding="utf-8"?>
<!-- Browser Resources — packs / shaders / mods (Modrinth) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_dialog"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_s4h_icon_tile">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_browser_resources" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browser Resources"
                android:textColor="#F3F3F7"
                android:textSize="15.5sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/cs_rb_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="—"
                android:textColor="#9A9AA6"
                android:textSize="10.5sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/cs_rb_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_rb_close" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/cs_rb_tab_packs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_cs_tab_pill_active"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingTop="7dp"
            android:paddingBottom="8dp"
            android:text="PACKS"
            android:textColor="#151518"
            android:textSize="9.5sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/cs_rb_tab_shaders"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cs_tab_pill_idle"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingTop="7dp"
            android:paddingBottom="8dp"
            android:text="SHADERS"
            android:textColor="#D0D0D0"
            android:textSize="9.5sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/cs_rb_tab_mods"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cs_tab_pill_idle"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingTop="7dp"
            android:paddingBottom="8dp"
            android:text="MODS"
            android:textColor="#D0D0D0"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/cs_rb_version_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="—"
        android:textColor="#8A8A96"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/cs_rb_search_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cs_tab_pill_idle"
            android:hint="Search Modrinth…"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="#F3F3F7"
            android:textColorHint="#6E7078"
            android:textSize="12sp" />
        <ImageButton
            android:id="@+id/cs_rb_search_clear"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_rb_close"
            android:visibility="gone" />
        <TextView
            android:id="@+id/cs_rb_search_btn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_cs_tab_pill_active"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="GO"
            android:textColor="#151518"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="12dp">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cs_rb_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never" />
        <ProgressBar
            android:id="@+id/cs_rb_loading"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="#B9BBC4" />
        <TextView
            android:id="@+id/cs_rb_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="—"
            android:textColor="#9A9AA6"
            android:textSize="11.5sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:letterSpacing="0.05"
        android:text="FILES GO TO THE CURRENT PROFILE FOLDER — MODS NEED GAME RESTART"
        android:textColor="#6E7078"
        android:textSize="7.5sp"
        android:textStyle="bold" />
</LinearLayout>
