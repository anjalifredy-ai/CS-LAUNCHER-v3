<?xml version="1.0" encoding="utf-8"?>
<!-- Remom Bedrock home — profiles + versions (Phase 2 UI) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_launcher_dark"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- LEFT: profiles -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_fastclient_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BEDROCK PROFILES"
            android:textColor="@color/accent_light"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Java jaisi list — har profile ek version target"
            android:textColor="@color/text_secondary_light"
            android:textSize="10sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bedrock_profile_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/bedrock_btn_add_profile"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_auth_primary_button"
            android:gravity="center"
            android:text="+ New Bedrock profile"
            android:textColor="@color/play_btn_text"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- RIGHT: version + play -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_fastclient_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/bedrock_selected_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Official (Play Store)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bedrock_owned_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/accent_light"
            android:textSize="11sp"
            tools:text="✓ Official Minecraft installed" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="VERSIONS"
            android:textColor="@color/text_secondary_light"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bedrock_version_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/bedrock_version_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Phase 1: Play opens the installed official app. Multi-version isolation = Phase 3."
            android:textColor="@color/text_secondary_dim"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/bedrock_btn_play"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_auth_primary_button"
            android:gravity="center"
            android:text="▶  PLAY BEDROCK"
            android:textColor="@color/play_btn_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
