<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Distant friends (no website needed here)"
            android:textColor="#F0F6FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="1. Server Start karo (Overview)\n2. PC / phone pe koi free tunnel se public address banao (playit agent, ngrok, etc.)\n3. Jo address mile (xxx.playit.gg:12345) yahan paste karo\n4. Save → friends Multiplayer me wahi address add karein\n\nIs screen pe koi website auto nahi khulegi."
            android:textColor="#A8C4D8"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Public / tunnel address"
            android:textColor="#7A9BB8"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/sd_reach_public"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_remom_tile"
            android:hint="abc.playit.gg:25565"
            android:inputType="textUri"
            android:paddingHorizontal="12dp"
            android:textColor="#F0F6FF"
            android:textColorHint="#5A7A98"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sd_btn_save_reach"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_remom_play"
            android:gravity="center"
            android:text="SAVE PUBLIC ADDRESS"
            android:textColor="#FFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sd_btn_copy_public"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_remom_tile"
            android:gravity="center"
            android:text="Copy public address"
            android:textColor="#3B9EFF" />

        <TextView
            android:id="@+id/sd_btn_reach_help"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Optional help (steps only — no forced site)"
            android:textColor="#7A9BB8"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="LAN only: same Wi‑Fi → Overview pe LAN IP use karo.\nMobile data / CGNAT pe public tunnel address zaroori hai — raw public IP aksar fail hota hai."
            android:textColor="#7A9BB8"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
