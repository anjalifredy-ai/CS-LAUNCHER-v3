<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/sd_playit_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_remom_card"
            android:padding="12dp"
            android:text="Playit: not linked"
            android:textColor="#F0F6FF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="One-time setup (Feather-style)\n1. Link playit (sign in once)\n2. Create Minecraft Java tunnel → local 127.0.0.1 and your server port\n3. Copy public address from playit\n4. Paste below → Save\nAfter that every server Start can use this address automatically."
            android:textColor="#7A9BB8"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/sd_btn_link_playit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_remom_play"
            android:gravity="center"
            android:text="1 · LINK PLAYIT (ONCE)"
            android:textColor="#FFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Public tunnel address"
            android:textColor="#7A9BB8"
            android:textSize="11sp" />
        <EditText
            android:id="@+id/sd_reach_public"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_remom_tile"
            android:hint="abc.playit.gg:12345"
            android:paddingHorizontal="12dp"
            android:textColor="#F0F6FF"
            android:textColorHint="#5A7A98"
            android:textSize="14sp"
            android:inputType="textUri" />

        <TextView
            android:id="@+id/sd_btn_save_reach"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_remom_tile"
            android:gravity="center"
            android:text="2 · SAVE + AUTO FOR ALL SERVERS"
            android:textColor="#3B9EFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sd_btn_copy_public"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_remom_tile"
            android:gravity="center"
            android:text="Copy public address"
            android:textColor="#3B9EFF" />

        <TextView
            android:id="@+id/sd_btn_clear_playit"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Unlink playit"
            android:textColor="#7A9BB8"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="LAN only: same Wi‑Fi → Overview LAN IP.\nDoor friends: need this playit address (or any tunnel). Phone + server + tunnel must stay on."
            android:textColor="#7A9BB8"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
