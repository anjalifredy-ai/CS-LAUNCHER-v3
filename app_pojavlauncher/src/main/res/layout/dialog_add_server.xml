<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_csc_panel"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:letterSpacing="0.08"
            android:text="ADD SERVER — V3.1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Enter IP address — live ping will fetch MOTD, players &amp; icon before you launch"
        android:textColor="#7F8894"
        android:textSize="9sp" />

    <EditText
        android:id="@+id/input_server_address"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_auth_input_box"
        android:hint="mc.hypixel.net  or  192.168.1.5:25565"
        android:imeOptions="actionDone"
        android:inputType="textUri"
        android:paddingHorizontal="14dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#5A636E"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/add_server_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#9AA3B0"
        android:textSize="10sp"
        android:visibility="gone"
        tools:text="Pinging… 142ms • 1.21.1 • 42/500"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_add_server_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_csc_outline_button"
            android:gravity="center"
            android:text="CANCEL"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_add_server_check"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_csc_outline_button"
            android:gravity="center"
            android:text="CHECK"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_add_server_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_csc_primary_button"
            android:elevation="2dp"
            android:gravity="center"
            android:text="ADD SERVER"
            android:textColor="#0B0D11"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
