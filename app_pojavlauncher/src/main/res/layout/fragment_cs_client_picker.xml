<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_csc_screen" android:orientation="horizontal" android:padding="16dp">
 <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.32" android:background="@drawable/bg_csc_panel" android:orientation="vertical" android:padding="16dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal"><TextView android:includeFontPadding="false" android:id="@+id/csc_picker_back" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_csc_outline_button" android:gravity="center" android:text="‹" android:textColor="#F2F3F5" android:textSize="28sp"/><ImageView android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="10dp" android:src="@drawable/cs_logo"/></LinearLayout>
  <TextView android:includeFontPadding="false" android:id="@+id/csc_picker_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textColor="#F2F3F5" android:textSize="19sp" android:textStyle="bold"/>
  <TextView android:includeFontPadding="false" android:id="@+id/csc_picker_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#7F8994" android:textSize="7sp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="18dp" android:background="@drawable/bg_csc_manifest_row" android:orientation="horizontal"><EditText android:id="@+id/csc_picker_search" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@null" android:hint="Search Modrinth" android:paddingHorizontal="12dp" android:singleLine="true" android:textColor="#F2F3F5" android:textColorHint="#67717C" android:textSize="10sp"/><TextView android:includeFontPadding="false" android:id="@+id/csc_picker_search_go" android:layout_width="72dp" android:layout_height="match_parent" android:gravity="center" android:text="SEARCH" android:textColor="#BCC3CC" android:textSize="8sp" android:textStyle="bold"/></LinearLayout>
  <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
  <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="MODRINTH VERIFIED • FABRIC FILTERED" android:textColor="#68737E" android:textSize="6sp"/>
  <TextView android:includeFontPadding="false" android:id="@+id/csc_picker_done" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="12dp" android:background="@drawable/bg_csc_primary_button" android:gravity="center" android:text="ADD SELECTED MODULES" android:textColor="#101419" android:textSize="9sp" android:textStyle="bold"/>
 </LinearLayout>
 <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="14dp" android:layout_weight="0.68" android:background="@drawable/bg_csc_panel">
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp"><TextView android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CS MODULES" android:textColor="#F2F3F5" android:textSize="17sp" android:textStyle="bold"/><TextView android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="TAP A CARD TO SELECT • COMPATIBILITY CHECKED" android:textColor="#7F8994" android:textSize="7sp"/><ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="10dp" android:layout_weight="1" android:overScrollMode="never" android:scrollbars="none"><LinearLayout android:id="@+id/csc_picker_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/></ScrollView></LinearLayout>
  <ProgressBar android:id="@+id/csc_picker_loading" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:indeterminateTint="#BCC3CC"/>
 </FrameLayout>
</LinearLayout>