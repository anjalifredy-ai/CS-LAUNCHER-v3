<?xml version="1.0" encoding="utf-8"?>
<!-- PREMIUM V4 — Runtime Forge (shared design system with JAR) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_runtime_setup_page">

    <!-- SELECT STATE -->
    <LinearLayout
        android:id="@+id/rs_select_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="22dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_runtime_chip_recommended"
            android:letterSpacing="0.16"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:text="RUNTIME FORGE"
            android:textColor="#D8C79A"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-light"
            android:text="@string/rs_title"
            android:textColor="#F0F0F3"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/rs_summary"
            android:textColor="#9C9CA8"
            android:textSize="12.5sp" />

        <!-- Cards scroll -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/rs_card_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/rs_offline_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_runtime_forge_offline"
            android:padding="10dp"
            android:text="@string/rs_offline_note"
            android:textColor="#E5A0A6"
            android:textSize="11sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/rs_btn_install"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_install_cta_white"
            android:elevation="3dp"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="@string/rs_install_cta"
            android:textColor="#0E0E11"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rs_btn_skip"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:paddingHorizontal="22dp"
            android:text="@string/rs_skip"
            android:textColor="#7C7C88"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- INSTALL STATE -->
    <LinearLayout
        android:id="@+id/rs_install_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="22dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_runtime_chip_recommended"
            android:letterSpacing="0.16"
            android:paddingHorizontal="9dp"
            android:paddingVertical="4dp"
            android:text="@string/rs_install_eyebrow"
            android:textColor="#D8C79A"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_rs_ring_halo" />

                <net.kdt.pojavlaunch.multirt.RuntimeRingView
                    android:id="@+id/rs_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/rs_overall_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-light"
                    android:textColor="#F0F0F3"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    tools:text="42%" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rs_overall_step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F0F0F3"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Installing Java 17…" />

                <TextView
                    android:id="@+id/rs_status_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#9C9CA8"
                    android:textSize="11.5sp"
                    tools:text="24.1 / 55 MB • 4.2 MB/s" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingEnd="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/rs_install_rows"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <View
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@drawable/bg_rs_fade_edge" />
        </FrameLayout>

        <TextView
            android:id="@+id/rs_btn_done"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_install_cta_white"
            android:elevation="3dp"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="@string/rs_done_cta"
            android:textColor="#0E0E11"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</FrameLayout>
