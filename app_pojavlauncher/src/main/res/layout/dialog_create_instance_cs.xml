<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 5 CREATE INSTANCE form — CS Plus master prompt -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg_pure_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CREATE INSTANCE"
            android:textColor="@color/cs_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.1"
            android:text="NAME"
            android:textAllCaps="true"
            android:textColor="@color/cs_text_secondary"
            android:textSize="10sp" />

        <EditText
            android:id="@+id/cs_ci_name"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/cs_bg_search_bar"
            android:hint="Instance name"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="@color/cs_text_primary"
            android:textColorHint="@color/cs_text_tertiary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.1"
            android:text="MEMORY"
            android:textAllCaps="true"
            android:textColor="@color/cs_text_secondary"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/cs_ci_memory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="8192"
                android:progress="2048"
                android:progressTint="@color/cs_brand_green"
                android:thumbTint="@color/cs_brand_green" />

            <TextView
                android:id="@+id/cs_ci_memory_value"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="2048 MB"
                android:textColor="@color/cs_text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.1"
            android:text="LOADER"
            android:textAllCaps="true"
            android:textColor="@color/cs_text_secondary"
            android:textSize="10sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/cs_ci_chip_vanilla" android:layout_width="wrap_content" android:layout_height="32dp" android:background="@drawable/cs_chip_outline" android:gravity="center" android:paddingHorizontal="12dp" android:text="Vanilla" android:textColor="@color/cs_text_primary" android:textSize="12sp" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/cs_ci_chip_fabric" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:background="@drawable/cs_chip_green" android:gravity="center" android:paddingHorizontal="12dp" android:text="Fabric" android:textColor="@color/cs_bg_pure_black" android:textSize="12sp" android:textStyle="bold" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/cs_ci_chip_forge" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:background="@drawable/cs_chip_outline" android:gravity="center" android:paddingHorizontal="12dp" android:text="Forge" android:textColor="@color/cs_text_primary" android:textSize="12sp" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/cs_ci_chip_neoforge" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:background="@drawable/cs_chip_outline" android:gravity="center" android:paddingHorizontal="12dp" android:text="NeoForge" android:textColor="@color/cs_text_primary" android:textSize="12sp" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/cs_ci_chip_quilt" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:background="@drawable/cs_chip_outline" android:gravity="center" android:paddingHorizontal="12dp" android:text="Quilt" android:textColor="@color/cs_text_primary" android:textSize="12sp" android:clickable="true" android:focusable="true" />
                <TextView android:id="@+id/cs_ci_chip_optifine" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:background="@drawable/cs_chip_outline" android:gravity="center" android:paddingHorizontal="12dp" android:text="OptiFine" android:textColor="@color/cs_text_primary" android:textSize="12sp" android:clickable="true" android:focusable="true" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.1"
            android:text="JAVA RUNTIME"
            android:textAllCaps="true"
            android:textColor="@color/cs_text_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/cs_ci_runtime"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/cs_bg_search_bar"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:text="Internal runtime"
            android:textColor="@color/cs_text_primary"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cs_ci_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/cs_btn_outline"
                android:gravity="center"
                android:text="@string/cs_btn_cancel"
                android:textColor="@color/cs_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/cs_ci_create"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/cs_btn_primary"
                android:gravity="center"
                android:text="Create"
                android:textColor="@color/cs_bg_pure_black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
