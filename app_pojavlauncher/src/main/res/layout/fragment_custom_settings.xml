<?xml version="1.0" encoding="utf-8"?>
<!-- Full-width CS Settings V2. Same resource is mirrored in layout-land. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_settings_deck_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/settings_header_bar"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <FrameLayout
                android:id="@+id/settings_back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_settings_deck_control"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/global_back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#E8E8EB" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="11dp"
                android:background="@drawable/bg_settings_deck_icon">
                <ImageView
                    android:id="@+id/settings_header_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_menu_settings"
                    app:tint="#EDEDF1" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/settings_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Settings"
                    android:textColor="#F5F5F7"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/settings_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#7F818B"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="330dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_settings_deck_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="11dp"
                android:paddingEnd="8dp">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cs_search"
                    app:tint="#72747F" />
                <EditText
                    android:id="@+id/settings_search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search every setting"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#F0F0F3"
                    android:textColorHint="#656772"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_live_badge"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_settings_deck_badge"
                android:gravity="center"
                android:letterSpacing="0.07"
                android:minWidth="56dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:textColor="#BFC1C9"
                android:textSize="7.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#26272E" />

        <HorizontalScrollView
            android:id="@+id/settings_category_rail_scroll"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/settings_category_rail"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#202127" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/settings_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="84dp"
            android:scrollbars="none" />
    </LinearLayout>

    <Space
        android:id="@+id/settings_dock_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/unsaved_changes_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="11dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_settings_deck_save"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingEnd="7dp">
            <TextView
                android:id="@+id/save_status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Unsaved changes"
                android:textColor="#D6B36B"
                android:textSize="10.5sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_save_settings"
                android:layout_width="112dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_settings_deck_apply"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="APPLY CHANGES"
                android:textAllCaps="true"
                android:textColor="#F2F2F5"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
