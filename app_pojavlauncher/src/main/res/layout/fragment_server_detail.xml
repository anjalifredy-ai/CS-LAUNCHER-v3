<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1628"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_remom_header"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/sd_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_remom_tile"
            android:gravity="center"
            android:text="‹"
            android:textColor="#F0F6FF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/sd_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:scaleType="centerCrop"
            android:background="#1B5E20" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sd_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Server"
                android:textColor="#F0F6FF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sd_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#7A9BB8"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/sd_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_remom_pill_off"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="OFFLINE"
            android:textColor="#F0F6FF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView android:id="@+id/sd_tab_overview" android:layout_width="wrap_content" android:layout_height="32dp"
                android:background="@drawable/bg_remom_pill_on" android:gravity="center" android:paddingHorizontal="14dp"
                android:text="Overview" android:textColor="#FFF" android:textSize="12sp" android:textStyle="bold"
                android:layout_marginEnd="6dp" />
            <TextView android:id="@+id/sd_tab_console" android:layout_width="wrap_content" android:layout_height="32dp"
                android:background="@drawable/bg_remom_pill_off" android:gravity="center" android:paddingHorizontal="14dp"
                android:text="Console" android:textColor="#F0F6FF" android:textSize="12sp"
                android:layout_marginEnd="6dp" />
            <TextView android:id="@+id/sd_tab_settings" android:layout_width="wrap_content" android:layout_height="32dp"
                android:background="@drawable/bg_remom_pill_off" android:gravity="center" android:paddingHorizontal="14dp"
                android:text="Settings" android:textColor="#F0F6FF" android:textSize="12sp"
                android:layout_marginEnd="6dp" />
            <TextView android:id="@+id/sd_tab_world" android:layout_width="wrap_content" android:layout_height="32dp"
                android:background="@drawable/bg_remom_pill_off" android:gravity="center" android:paddingHorizontal="14dp"
                android:text="World" android:textColor="#F0F6FF" android:textSize="12sp"
                android:layout_marginEnd="6dp" />
            <TextView android:id="@+id/sd_tab_reach" android:layout_width="wrap_content" android:layout_height="32dp"
                android:background="@drawable/bg_remom_pill_off" android:gravity="center" android:paddingHorizontal="14dp"
                android:text="Reach" android:textColor="#F0F6FF" android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/sd_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
