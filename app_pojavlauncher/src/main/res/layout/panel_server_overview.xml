<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_remom_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="CONTROL" android:textColor="#7A9BB8" android:textSize="10sp" android:textStyle="bold" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:orientation="horizontal">

                <TextView android:id="@+id/sd_btn_start" android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:background="@drawable/bg_remom_play" android:gravity="center"
                    android:text="▶ START" android:textColor="#FFF" android:textStyle="bold"
                    android:layout_marginEnd="8dp" />
                <TextView android:id="@+id/sd_btn_stop" android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:background="@drawable/bg_cs_danger_button" android:gravity="center"
                    android:text="■ STOP" android:textColor="#FFF" android:textStyle="bold"
                    android:layout_marginEnd="8dp" />
                <TextView android:id="@+id/sd_btn_restart" android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:background="@drawable/bg_remom_tile" android:gravity="center"
                    android:text="↻ RESTART" android:textColor="#3B9EFF" android:textStyle="bold" />
            </LinearLayout>

            <TextView android:id="@+id/sd_btn_prepare" android:layout_width="match_parent" android:layout_height="40dp"
                android:layout_marginTop="8dp" android:background="@drawable/bg_remom_tile" android:gravity="center"
                android:text="Install / Prepare JAR" android:textColor="#3B9EFF" android:textSize="13sp" />
            <TextView android:id="@+id/sd_btn_plugins" android:layout_width="match_parent" android:layout_height="40dp"
                android:layout_marginTop="8dp" android:background="@drawable/bg_remom_tile" android:gravity="center"
                android:text="Browse plugins / mods" android:textColor="#3B9EFF" android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_remom_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="LIVE STATUS" android:textColor="#7A9BB8" android:textSize="10sp" android:textStyle="bold" />

            <TextView android:id="@+id/sd_stat_ram" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="RAM: —" android:textColor="#F0F6FF" android:textSize="13sp" />
            <TextView android:id="@+id/sd_stat_port" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Port: —" android:textColor="#F0F6FF" android:textSize="13sp" />
            <TextView android:id="@+id/sd_stat_soft" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Software: —" android:textColor="#F0F6FF" android:textSize="13sp" />
            <TextView android:id="@+id/sd_stat_bg" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Background: —" android:textColor="#F0F6FF" android:textSize="13sp" />
            <TextView android:id="@+id/sd_stat_battery" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Battery: keep screen on / charging recommended" android:textColor="#7A9BB8" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_remom_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="QUICK JOIN" android:textColor="#7A9BB8" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/sd_addr_lan" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="LAN: —" android:textColor="#F0F6FF" android:textSize="13sp" />
            <TextView android:id="@+id/sd_addr_public" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Public: —" android:textColor="#F0F6FF" android:textSize="13sp" />
            <TextView android:id="@+id/sd_btn_copy_addr" android:layout_width="match_parent" android:layout_height="40dp"
                android:layout_marginTop="10dp" android:background="@drawable/bg_remom_tile" android:gravity="center"
                android:text="Copy best address" android:textColor="#3B9EFF" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
