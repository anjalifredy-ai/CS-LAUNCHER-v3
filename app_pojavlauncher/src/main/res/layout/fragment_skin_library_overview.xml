<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skin_overview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_skin_library_page">

    <LinearLayout
        android:id="@+id/skin_overview_header"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/skin_overview_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_skin_slot_action"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"
                app:tint="#E4E4EA" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="MY SKINS"
                android:textColor="#F5F5F7"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/skin_overview_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textColor="#8B8D97"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/skin_overview_active"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_skin_slot_status"
            android:gravity="center"
            android:paddingHorizontal="11dp"
            android:text="NO ACTIVE SKIN"
            android:textColor="#C9CBD6"
            android:textSize="7.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/skin_overview_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#292A31"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skin_overview_header" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/skin_overview_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skin_overview_divider">

        <LinearLayout
            android:id="@+id/skin_overview_slots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center"
            android:minHeight="290dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp" />
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>