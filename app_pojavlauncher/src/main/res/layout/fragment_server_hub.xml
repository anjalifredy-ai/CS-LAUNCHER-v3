<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1220">

    <LinearLayout
        android:id="@+id/server_hub_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_remom_card">

        <TextView
            android:id="@+id/server_hub_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#F0F6FF"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/server_hub_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Servers"
            android:textColor="#F0F6FF"
            android:textStyle="bold"
            android:textSize="17sp"
            android:paddingStart="8dp" />

        <TextView
            android:id="@+id/server_hub_refresh"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Refresh"
            android:textColor="#3B9EFF"
            android:textStyle="bold"
            android:background="@drawable/bg_remom_tile"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- HOST ON THIS PHONE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_remom_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOST ON THIS PHONE"
                    android:textColor="#3B9EFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="1) Create   2) Start   3) Copy public address"
                    android:textColor="#F0F6FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Solo 127.0.0.1 · Wi‑Fi phone IP · Internet bore.pub auto"
                    android:textColor="#7A9BB8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/local_servers_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_remom_tile"
                    android:padding="14dp"
                    android:text="No local servers — tap CREATE SERVER"
                    android:textColor="#F0F6FF"
                    android:textSize="13sp"
                    android:minHeight="56dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_create_local_server"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.5"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_remom_play"
                        android:gravity="center"
                        android:text="＋ CREATE SERVER"
                        android:textColor="#0A1628"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btn_start_local_server"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_remom_tile"
                        android:gravity="center"
                        android:text="Open"
                        android:textColor="#F0F6FF"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btn_stop_local_server"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_remom_tile"
                        android:gravity="center"
                        android:text="Stop all"
                        android:textColor="#F0F6FF"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- LAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_remom_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAN / WIFI"
                    android:textColor="#3B9EFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lan_host_ip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="—"
                    android:textColor="#F0F6FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/lan_copy_ip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/bg_remom_tile" android:gravity="center" android:text="Copy IP" android:textColor="#F0F6FF" android:textStyle="bold" />
                    <TextView android:id="@+id/lan_refresh_ip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_remom_tile" android:gravity="center" android:text="Refresh" android:textColor="#F0F6FF" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tunnel help -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_remom_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REMOTE FRIENDS"
                    android:textColor="#3B9EFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Start local server — public bore.pub:PORT appears on dashboard. Friends paste in Multiplayer."
                    android:textColor="#7A9BB8"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/tunnel_public_input"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_remom_tile"
                    android:hint="Optional: paste public address"
                    android:textColor="#F0F6FF"
                    android:textColorHint="#5A7A9A"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/btn_open_playit" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/bg_remom_tile" android:gravity="center" android:text="Help" android:textColor="#F0F6FF" android:textStyle="bold" />
                    <TextView android:id="@+id/btn_save_tunnel" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/bg_remom_tile" android:gravity="center" android:text="Save" android:textColor="#F0F6FF" android:textStyle="bold" />
                    <TextView android:id="@+id/btn_tunnel_help" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_remom_tile" android:gravity="center" android:text="Tips" android:textColor="#F0F6FF" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Add remote server to list -->
            <LinearLayout
                android:id="@+id/server_hub_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_remom_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADD TO MULTIPLAYER LIST"
                    android:textColor="#3B9EFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/server_hub_name"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_remom_tile"
                    android:hint="Name"
                    android:textColor="#F0F6FF"
                    android:textColorHint="#5A7A9A"
                    android:paddingHorizontal="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/server_hub_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_remom_tile"
                        android:hint="Address / IP"
                        android:textColor="#F0F6FF"
                        android:textColorHint="#5A7A9A"
                        android:paddingHorizontal="12dp" />
                    <TextView
                        android:id="@+id/server_hub_add"
                        android:layout_width="72dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_remom_play"
                        android:gravity="center"
                        android:text="ADD"
                        android:textColor="#0A1628"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/server_hub_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0 saved"
                    android:textColor="#7A9BB8"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Cloud hosts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_remom_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CLOUD HOST · IN APP"
                    android:textColor="#3B9EFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/free_host_aternos" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_remom_tile" android:gravity="center" android:text="Aternos" android:textColor="#F0F6FF" android:textSize="12sp" />
                    <TextView android:id="@+id/free_host_exaroton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_remom_tile" android:gravity="center" android:text="Exaroton" android:textColor="#F0F6FF" android:textSize="12sp" />
                    <TextView android:id="@+id/free_host_minehut" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/bg_remom_tile" android:gravity="center" android:text="Minehut" android:textColor="#F0F6FF" android:textSize="12sp" />
                    <TextView android:id="@+id/free_host_help" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_remom_tile" android:gravity="center" android:text="?" android:textColor="#F0F6FF" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/server_hub_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/server_hub_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:text="No saved multiplayer addresses"
                android:textColor="#5A7A9A"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
