<?xml version="1.0" encoding="utf-8"?>
<!-- Remom Server Hub: free cloud + LAN friends + join list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_launcher_dark"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/server_hub_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_header_bar"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/server_hub_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/accent_primary"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/play_btn_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/server_hub_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Servers"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Join · free host · friends LAN"
                android:textColor="@color/text_secondary_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/server_hub_refresh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_csc_outline_button"
            android:gravity="center"
            android:text="↻"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_server_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="FREE SERVER HOSTING"
                    android:textColor="@color/accent_light"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Cloud free hosts. Create on site → copy IP → Add below → Play. Sleep when empty."
                    android:textColor="@color/text_secondary_light"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/free_host_aternos"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_auth_primary_button"
                        android:gravity="center"
                        android:text="Aternos"
                        android:textColor="@color/play_btn_text"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/free_host_minehut"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_csc_outline_button"
                        android:gravity="center"
                        android:text="Minehut"
                        android:textColor="@color/accent_light"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/free_host_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="How it works? Tap here"
                    android:textColor="@color/text_secondary_dim"
                    android:textSize="10sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_server_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="FRIENDS · SAME WIFI"
                    android:textColor="#3B9EFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Host: world open → Pause → Open to LAN. Friends same Wi‑Fi join with your IP (port LAN screen pe). No big dedicated server needed."
                    android:textColor="@color/text_secondary_light"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/lan_host_ip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_auth_input_box"
                    android:padding="12dp"
                    android:text="Detecting Wi‑Fi IP…"
                    android:textColor="#F0F6FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lan_copy_ip"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_auth_primary_button"
                        android:gravity="center"
                        android:text="Copy IP"
                        android:textColor="@color/play_btn_text"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/lan_refresh_ip"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_csc_outline_button"
                        android:gravity="center"
                        android:text="Refresh IP"
                        android:textColor="@color/accent_light"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/server_hub_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_server_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="ADD SERVER"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Friend IP, Aternos/Minehut, or any Java server"
                    android:textColor="#7F8894"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_auth_input_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <EditText
                        android:id="@+id/server_hub_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="192.168.x.x:25565 or play.example.com"
                        android:imeOptions="actionDone"
                        android:inputType="textUri"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#5A636E"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/server_hub_add"
                        android:layout_width="76dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_auth_primary_button"
                        android:elevation="1dp"
                        android:gravity="center"
                        android:text="ADD"
                        android:textColor="@color/play_btn_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/server_hub_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#9AA3B0"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:text="Pinging…"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.06"
                android:text="YOUR SERVERS — TAP PLAY"
                android:textColor="#9AA3B0"
                android:textSize="8sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/server_hub_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/server_hub_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_empty_state"
                android:gravity="center"
                android:padding="16dp"
                android:text="Friend IP ya free host IP add karo — ping, Play."
                android:textColor="#6B7280"
                android:textSize="11sp"
                android:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
