<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D11"
    android:orientation="vertical">

    <!-- Header — back + title -->
    <LinearLayout
        android:id="@+id/server_hub_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#14161E"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/server_hub_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#FFFFFF"
            android:gravity="center"
            android:text="‹"
            android:textColor="#0B0D11"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/server_hub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Servers"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_stat_chip"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:text="V3.1"
                    android:textColor="#FFFFFF"
                    android:textSize="7sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_compat_ok"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:text="LIVE PING"
                    android:textColor="#FFFFFF"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Partner server • live ping • 1-tap join"
                android:textColor="#6B7280"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/server_hub_refresh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_csc_outline_button"
            android:gravity="center"
            android:text="↻"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/server_hub_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_server_card"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="12dp"
                        android:background="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:letterSpacing="0.08"
                        android:text="ADD SERVER"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="16dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_stat_chip"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:text="IP → LIVE DATA"
                        android:textColor="#FFFFFF"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Enter IP, see MOTD, players, ping &amp; icon before launch — Zalith style"
                    android:textColor="#7F8894"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_auth_input_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <EditText
                        android:id="@+id/server_hub_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="mc.hypixel.net  or  play.example.com:25565"
                        android:imeOptions="actionDone"
                        android:inputType="textUri"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#5A636E"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/server_hub_add"
                        android:layout_width="76dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_csc_primary_button"
                        android:elevation="1dp"
                        android:gravity="center"
                        android:text="ADD"
                        android:textColor="#0B0D11"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/server_hub_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#9AA3B0"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:text="Pinging…"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.06"
                android:text="YOUR SERVERS — TAP PLAY FOR 1-CLICK"
                android:textColor="#9AA3B0"
                android:textSize="8sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/server_hub_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/server_hub_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_empty_state"
                android:gravity="center"
                android:padding="16dp"
                android:text="Add your own servers above — live MOTD, players and ping appear instantly. Tap PLAY on any card to jump straight in."
                android:textColor="#6B7280"
                android:textSize="11sp"
                android:visibility="visible" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="V3.1 Server Hub • Live ping • Auto favicon • 1-Click --server --port • Zalith research"
                android:textColor="#3E4552"
                android:textSize="7sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
