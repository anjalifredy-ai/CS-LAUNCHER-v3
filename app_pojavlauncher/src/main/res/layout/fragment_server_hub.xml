<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_launcher_dark"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/server_hub_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_header_bar"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/server_hub_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/accent_primary"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/play_btn_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/server_hub_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Servers"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Solo · same Wi‑Fi · distant friends"
                android:textColor="@color/text_secondary_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/server_hub_refresh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_csc_outline_button"
            android:gravity="center"
            android:text="↻"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- LOCAL IN-APP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_server_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="HOST INSIDE REMOM"
                    android:textColor="#3B9EFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Solo = 127.0.0.1 (IP nahi). Same Wi‑Fi friends = neeche wala IP. Door ke friends = neeche Internet host."
                    android:textColor="@color/text_secondary_light"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/local_servers_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_auth_input_box"
                    android:padding="12dp"
                    android:text="No local servers yet"
                    android:textColor="#F0F6FF"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/btn_create_local_server"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:layout_marginEnd="4dp" android:background="@drawable/bg_auth_primary_button"
                        android:gravity="center" android:text="Create" android:textColor="@color/play_btn_text"
                        android:textStyle="bold" android:clickable="true" android:focusable="true" />

                    <TextView android:id="@+id/btn_start_local_server"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:layout_marginHorizontal="4dp" android:background="@drawable/bg_csc_outline_button"
                        android:gravity="center" android:text="Start" android:textColor="@color/accent_light"
                        android:textStyle="bold" android:clickable="true" android:focusable="true" />

                    <TextView android:id="@+id/btn_stop_local_server"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:layout_marginStart="4dp" android:background="@drawable/bg_csc_outline_button"
                        android:gravity="center" android:text="Stop" android:textColor="#FF8A80"
                        android:textStyle="bold" android:clickable="true" android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- DISTANT FRIENDS — internet free host -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_server_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="DISTANT FRIENDS · INTERNET"
                    android:textColor="#FFB74D"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Door city / alag network? Phone Wi‑Fi IP kaam nahi karega. Free cloud host banao → IP copy → yahan ADD → Play."
                    android:textColor="@color/text_secondary_light"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/free_host_aternos"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_auth_primary_button"
                        android:gravity="center"
                        android:text="Aternos (free)"
                        android:textColor="@color/play_btn_text"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/free_host_minehut"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_csc_outline_button"
                        android:gravity="center"
                        android:text="Minehut (free)"
                        android:textColor="@color/accent_light"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/free_host_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Kaise? Tap — short guide"
                    android:textColor="@color/text_secondary_dim"
                    android:textSize="10sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- LAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_server_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="SAME WIFI · NEARBY"
                    android:textColor="#3B9EFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lan_host_ip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_auth_input_box"
                    android:padding="12dp"
                    android:text="Detecting…"
                    android:textColor="#F0F6FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/lan_copy_ip"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:layout_marginEnd="6dp" android:background="@drawable/bg_auth_primary_button"
                        android:gravity="center" android:text="Copy Wi‑Fi IP" android:textColor="@color/play_btn_text"
                        android:textStyle="bold" android:clickable="true" android:focusable="true" />

                    <TextView android:id="@+id/lan_refresh_ip"
                        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:layout_marginStart="6dp" android:background="@drawable/bg_csc_outline_button"
                        android:gravity="center" android:text="Refresh" android:textColor="@color/accent_light"
                        android:textStyle="bold" android:clickable="true" android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/server_hub_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_server_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="ADD / JOIN"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Aternos IP, friend IP, ya 127.0.0.1:25565 (solo)"
                    android:textColor="#7F8894"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_auth_input_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <EditText
                        android:id="@+id/server_hub_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="address or IP:port"
                        android:imeOptions="actionDone"
                        android:inputType="textUri"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#5A636E"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/server_hub_add"
                        android:layout_width="76dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_auth_primary_button"
                        android:gravity="center"
                        android:text="ADD"
                        android:textColor="@color/play_btn_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/server_hub_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#9AA3B0"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.06"
                android:text="YOUR SERVERS — TAP PLAY"
                android:textColor="#9AA3B0"
                android:textSize="8sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/server_hub_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/server_hub_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_empty_state"
                android:gravity="center"
                android:padding="16dp"
                android:text="Solo Start / Aternos IP / friend IP add karo"
                android:textColor="#6B7280"
                android:textSize="11sp"
                android:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
