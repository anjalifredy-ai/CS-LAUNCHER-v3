<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/runtime_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_runtime_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingTop="14dp"
    android:paddingBottom="10dp"
    android:elevation="1dp">

    <FrameLayout
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_deck_icon_tile">

        <View
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#FFFFFF" />

        <TextView
            android:id="@+id/runtime_major_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#0B0B0E"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="21" />
    </FrameLayout>

    <TextView
        android:id="@+id/runtime_name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Java 21" />

    <TextView
        android:id="@+id/runtime_role_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:maxLines="2"
        android:minHeight="20dp"
        android:textColor="#9FA3B0"
        android:textSize="8sp"
        tools:text="1.20.5 — 1.21.1" />

    <TextView
        android:id="@+id/runtime_chip"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_runtime_chip_neutral"
        android:gravity="center"
        android:paddingHorizontal="6dp"
        android:textColor="#FFFFFF"
        android:textSize="7sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="RECOMMENDED"
        tools:visibility="visible" />

    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_runtime_state_well">

        <ImageView
            android:id="@+id/runtime_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_check_circle"
            android:padding="3dp"
            android:src="@drawable/ic_check_small"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/runtime_spinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
