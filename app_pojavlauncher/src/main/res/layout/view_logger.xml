<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     CS PREMIUM GLASS TERMINAL (Phase 3)
     Translucent glass chrome · live/pause dot · search · copy · export ·
     clear · autoscroll · severity-highlighted animated line stream.
     All legacy IDs preserved — LoggerView/MainActivity keep working.
     ═══════════════════════════════════════════════════════════════════ -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/log_terminal_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_log_glass_card"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- ── ROW 1: status + actions ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_log_glass_toolbar"
            android:paddingHorizontal="12dp">

            <View
                android:id="@+id/log_live_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_log_dot_live" />

            <TextView
                android:id="@+id/log_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="@string/log_view_label_log_output"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/log_count_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FF6B7280"
                android:textSize="9.5sp"
                android:fontFamily="monospace" />

            <!-- legacy toggle ids preserved (compact icon style now) -->
            <ToggleButton
                android:id="@+id/content_log_toggle_autoscroll"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_log_toggle"
                android:textOff="@string/log_view_button_scroll_off"
                android:textOn="@string/log_view_button_scroll_on"
                android:textColor="#D0D0D0"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:paddingHorizontal="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <ToggleButton
                android:id="@+id/content_log_toggle_log"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_log_toggle"
                android:textOff="@string/log_view_button_output_off"
                android:textOn="@string/log_view_button_output_on"
                android:textColor="#D0D0D0"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:paddingHorizontal="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <ImageButton
                android:id="@+id/log_view_cancel"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_log_close"
                android:background="@drawable/bg_log_toggle"
                android:contentDescription="@string/log_view_button_output_off"
                app:tint="#D0D0D0" />
        </LinearLayout>

        <!-- ── ROW 2: search + quick actions ── -->
        <LinearLayout
            android:id="@+id/log_actions_row"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_log_search"
                android:paddingHorizontal="9dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_cs_search"
                    app:tint="#6B7280" />

                <EditText
                    android:id="@+id/log_search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:background="@null"
                    android:hint="@string/cs_log_search_hint"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#FF6B7280"
                    android:textSize="11.5sp"
                    android:fontFamily="monospace" />

                <ImageView
                    android:id="@+id/log_search_clear"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="3dp"
                    android:src="@drawable/ic_log_close"
                    android:visibility="gone"
                    app:tint="#A0A0AA" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/log_btn_pause"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_log_icon_btn"
                android:contentDescription="@string/cs_log_pause"
                android:src="@drawable/ic_log_pause"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/log_btn_copy"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_log_icon_btn"
                android:contentDescription="@string/cs_log_copy"
                android:src="@drawable/ic_log_copy"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/log_btn_export"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_log_icon_btn"
                android:contentDescription="@string/cs_log_export"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_menu_share"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/log_btn_clear"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_log_icon_btn"
                android:contentDescription="@string/cs_log_clear"
                android:src="@drawable/ic_menu_delete_forever"
                app:tint="#FFFF4444" />
        </LinearLayout>

        <!-- Terminal body + centered CLI splash overlay. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#99060708">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/content_log_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingVertical="6dp" />

            <FrameLayout
                android:id="@+id/log_cli_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="#F208090C"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:maxWidth="560dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp">

                    <!-- terminal window chrome -->
                    <LinearLayout
                        android:id="@+id/log_cli_titlebar"
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/bg_cli_dot_red" />

                        <View
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/bg_cli_dot_amber" />

                        <View
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/bg_cli_dot_green" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:gravity="center"
                            android:text="cs@launcher: ~/minecraft"
                            android:textColor="#6C707C"
                            android:textSize="8.5sp" />

                        <Space
                            android:layout_width="36dp"
                            android:layout_height="1dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="7dp"
                        android:background="#1C2029" />

                    <TextView
                        android:id="@+id/log_cli_command"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:gravity="center_vertical"
                        android:fontFamily="monospace"
                        android:textColor="#D7D8DE"
                        android:textSize="10sp" />

                    <!--
                      Pixel-grid CS mark. Replaces the old ASCII-art TextView, whose box-drawing
                      characters were missing from the monospace font and broke the logo apart.
                    -->
                    <com.kdt.CsBlockLogoView
                        android:id="@+id/log_cli_ascii"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/log_cli_brand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:letterSpacing="0.22"
                        android:maxLines="1"
                        android:text="CS LAUNCHER"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/log_cli_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center"
                        android:letterSpacing="0.14"
                        android:text="VERSION 3  •  CRAFT STUDIO"
                        android:textColor="#777984"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/log_cli_status"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="15dp"
                        android:gravity="center_vertical"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="4dp"
                        android:textColor="#C7C9D0"
                        android:textSize="9.5sp" />

                    <ProgressBar
                        android:id="@+id/log_cli_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_cli_progress" />

                    <TextView
                        android:id="@+id/log_cli_progress_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:fontFamily="monospace"
                        android:text="[&gt;                     ]   0%"
                        android:textColor="#8C8E98"
                        android:textSize="8.5sp" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- legacy id kept for compatibility (zero-size, unused) -->
    <View
        android:id="@+id/top_log_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
