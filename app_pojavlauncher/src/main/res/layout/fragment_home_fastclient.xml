<?xml version="1.0" encoding="utf-8"?>
<!-- Remom home — horizontal, own blue chrome (not CS profile cards) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0A1628"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/left_pane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:orientation="vertical"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_remom_card"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PLAYER"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#5A7A9A"
            android:letterSpacing="0.15"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/card_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_remom_avatar_ring"
                android:padding="3dp">
                <ImageView
                    android:id="@+id/iv_player_head"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Player" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_player_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Player"
                    android:textColor="#F0F6FF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_player_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Offline"
                    android:textColor="#7AB8FF"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_profile_setting"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_remom_tile"
                android:src="@drawable/ic_menu_settings"
                android:scaleType="fitCenter"
                android:padding="7dp"
                android:contentDescription="Profile settings" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E3A5F"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INSTANCE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#5A7A9A"
            android:letterSpacing="0.15"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_profile_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Default"
            android:textColor="#F0F6FF"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tv_folder_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#7A9BB8"
            android:textSize="11sp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/chip_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginEnd="6dp" android:text="1.20" android:textSize="10sp" android:textColor="#0A1628" android:background="@drawable/bg_remom_pill_on" />
            <TextView android:id="@+id/chip_loader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginEnd="6dp" android:text="Vanilla" android:textSize="10sp" android:textColor="#C8D8EC" android:background="@drawable/bg_remom_pill_off" />
            <TextView android:id="@+id/chip_java" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_marginEnd="6dp" android:text="Java" android:textSize="10sp" android:textColor="#C8D8EC" android:background="@drawable/bg_remom_pill_off" />
            <TextView android:id="@+id/chip_ram" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:text="2GB" android:textSize="10sp" android:textColor="#C8D8EC" android:background="@drawable/bg_remom_pill_off" />
        </LinearLayout>

        <TextView android:id="@+id/tv_profile_ram_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="" android:textColor="#5A7A9A" android:textSize="10sp" />

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_select_profile"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="Change instance"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#B8D0EC"
            android:background="@drawable/bg_remom_tile"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.35"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_remom_card"
        android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="READY TO PLAY" android:textSize="11sp" android:textStyle="bold" android:textColor="#5A7A9A" android:letterSpacing="0.2" android:layout_marginBottom="8dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Minecraft Java" android:textSize="22sp" android:textStyle="bold" android:textColor="#F0F6FF" android:layout_marginBottom="6dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Same profile · mods · worlds" android:textSize="12sp" android:textColor="#7A9BB8" android:gravity="center" android:layout_marginBottom="22dp" />

        <net.kdt.pojavlaunch.ui.PremiumPlayButtonView
            android:id="@+id/btn_play_main"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_remom_play"
            android:gravity="center"
            android:text="PLAY"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:id="@+id/card_notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="@drawable/bg_remom_tile"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/tv_notification_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#F0F6FF" android:textSize="13sp" android:textStyle="bold" />
                <ImageView android:id="@+id/btn_dismiss_notification" android:layout_width="18dp" android:layout_height="18dp" android:contentDescription="@null" />
            </LinearLayout>
            <TextView android:id="@+id/tv_notification_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#9BB0C9" android:textSize="11sp" android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/infrawire_card_play" android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone" android:orientation="vertical">
            <TextView android:id="@+id/tv_partner_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
            <TextView android:id="@+id/tv_partner_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:orientation="vertical"
        android:background="@drawable/bg_remom_card"
        android:padding="14dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="QUICK" android:textSize="10sp" android:textStyle="bold" android:textColor="#5A7A9A" android:letterSpacing="0.15" android:layout_marginBottom="10dp" />

        <TextView android:id="@+id/btn_add_server" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginBottom="8dp" android:text="  Servers" android:textSize="14sp" android:textStyle="bold" android:textColor="#E8F0FA" android:background="@drawable/bg_remom_tile" android:clickable="true" android:focusable="true" />
        <TextView android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginBottom="8dp" android:text="  Mods · packs" android:textSize="14sp" android:textStyle="bold" android:textColor="#E8F0FA" android:background="@drawable/bg_remom_tile" />
        <TextView android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginBottom="8dp" android:text="  Skins" android:textSize="14sp" android:textStyle="bold" android:textColor="#E8F0FA" android:background="@drawable/bg_remom_tile" />
        <TextView android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginBottom="8dp" android:text="  Controls" android:textSize="14sp" android:textStyle="bold" android:textColor="#E8F0FA" android:background="@drawable/bg_remom_tile" />

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Remom · Java on mobile" android:textSize="10sp" android:textColor="#3A5570" />
    </LinearLayout>
</LinearLayout>
