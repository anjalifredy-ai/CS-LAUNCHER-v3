<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg_pure_black"
    android:orientation="vertical">

    <include layout="@layout/cs_top_app_bar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CS"
                android:textColor="@color/cs_brand_green"
                android:textStyle="bold"
                android:textSize="32sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="CS LAUNCHER PLUS"
                android:textColor="@color/cs_text_primary"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="PLAY BEYOND LIMITS"
                android:textColor="@color/cs_text_secondary"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Version 1.0.0"
                android:textColor="@color/cs_text_tertiary"
                android:textSize="11sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cs_card_bg"
                android:padding="16dp"
                android:layout_marginTop="24dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="About" android:textColor="@color/cs_text_primary"
                    android:textStyle="bold" android:textSize="13sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Custom Minecraft launcher fork based on PojavLauncher"
                    android:textColor="@color/cs_text_secondary" android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cs_card_bg"
                android:padding="16dp"
                android:layout_marginTop="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Credits" android:textColor="@color/cs_text_primary"
                    android:textStyle="bold" android:textSize="13sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="PojavLauncher Team · Modrinth · Material Design"
                    android:textColor="@color/cs_text_secondary" android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cs_card_bg"
                android:padding="16dp"
                android:layout_marginTop="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="License — MIT" android:textColor="@color/cs_text_primary"
                    android:textStyle="bold" android:textSize="13sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Made with love by ROHIT"
                android:textColor="@color/cs_text_tertiary"
                android:textSize="11sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
