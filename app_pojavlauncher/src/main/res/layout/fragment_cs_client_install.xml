<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#090D11" android:clickable="true" android:focusable="true">
    <net.kdt.pojavlaunch.csclient.CsClientInstallView
        android:id="@+id/csc_full_install_visual"
        android:layout_width="match_parent" android:layout_height="match_parent"/>
    <TextView android:id="@+id/csc_install_exit"
        android:layout_width="180dp" android:layout_height="44dp"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="24dp"
        android:background="@drawable/bg_csc_outline_button" android:gravity="center"
        android:text="RETURN TO BUILDER" android:textColor="#F2F3F5" android:textSize="10sp" android:textStyle="bold"/>
</FrameLayout>