<?xml version="1.0" encoding="utf-8"?>
<!-- RUNTIME CARD V6 — DARK WHITE BLACK, new centered positions, researched premium -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/runtime_card_root"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_runtime_card"
    android:elevation="1dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <!-- White circle number -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_deck_icon_tile">

        <View
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle"
            android:backgroundTint="#FFFFFF" />

        <TextView
            android:id="@+id/runtime_major_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#0B0B0E"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="17" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/runtime_name_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Java 17" />

            <TextView
                android:id="@+id/runtime_chip"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_runtime_chip_neutral"
                android:gravity="center"
                android:paddingHorizontal="7dp"
                android:textColor="#FFFFFF"
                android:textSize="7.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="RECOMMENDED"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/runtime_role_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#9FA3B0"
            android:textSize="11sp"
            tools:text="Minecraft 1.17 — 1.20.4 • LTS" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_stat_chip"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:text="64-bit • HotSpot"
            android:textColor="#FFFFFF"
            android:textSize="7sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_runtime_state_well">

        <ImageView
            android:id="@+id/runtime_check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_check_circle"
            android:padding="4dp"
            android:src="@drawable/ic_check_small"
            android:visibility="gone"
            tools:visibility="visible" />

        <ProgressBar
            android:id="@+id/runtime_spinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
