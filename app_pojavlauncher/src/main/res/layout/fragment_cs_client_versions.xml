<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_csc_screen">
 <ImageView android:layout_width="280dp" android:layout_height="280dp" android:layout_gravity="center" android:alpha="0.025" android:src="@drawable/cs_logo"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="16dp">
  <LinearLayout android:id="@+id/csc_versions_header" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.34" android:background="@drawable/bg_csc_panel" android:orientation="vertical" android:padding="18dp">
   <TextView android:includeFontPadding="false" android:id="@+id/csc_versions_back" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_csc_outline_button" android:gravity="center" android:text="‹" android:textColor="#F2F3F5" android:textSize="28sp"/>
   <ImageView android:layout_width="78dp" android:layout_height="78dp" android:layout_gravity="center_horizontal" android:layout_marginTop="18dp" android:src="@drawable/cs_logo"/>
   <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="CS CLIENT" android:textColor="#F2F3F5" android:textSize="21sp" android:textStyle="bold"/>
   <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="PROFILE BUILDER • MODRINTH VERIFIED" android:textColor="#7F8994" android:textSize="7sp"/>
   <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
   <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="LATEST COMPATIBLE BLAZE BUILD\nSELECTED AUTOMATICALLY" android:textColor="#68737E" android:textSize="6sp"/>
  </LinearLayout>
  <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="14dp" android:layout_weight="0.66" android:background="@drawable/bg_csc_panel">
   <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <TextView android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SELECT MINECRAFT VERSION" android:textColor="#F2F3F5" android:textSize="18sp" android:textStyle="bold"/>
    <TextView android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="FABRIC • BLAZE CLIENT • VERIFIED BUILDS" android:textColor="#7F8994" android:textSize="7sp"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1" android:overScrollMode="never" android:scrollbars="none"><LinearLayout android:id="@+id/csc_versions_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/></ScrollView>
   </LinearLayout>
   <ProgressBar android:id="@+id/csc_versions_loading" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:indeterminateTint="#BCC3CC"/>
  </FrameLayout>
 </LinearLayout>
</FrameLayout>