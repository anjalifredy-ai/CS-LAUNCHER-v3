<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_skin_library_page">

    <LinearLayout
        android:id="@+id/skin_top_bar"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout android:id="@+id/skin_back_button" android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_skin_slot_action" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:src="@drawable/ic_arrow_back" app:tint="#DAE7DE" android:contentDescription="Back" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SKIN LIBRARY" android:textColor="#EDF5F0" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Three saved looks • one active skin" android:textColor="#70877A" android:textSize="9sp" />
        </LinearLayout>
        <TextView android:id="@+id/tv_server_status_chip" android:layout_width="wrap_content" android:layout_height="24dp" android:background="@drawable/bg_skin_slot_status" android:gravity="center" android:paddingHorizontal="9dp" android:text="SYNC READY" android:textColor="#A9C9B3" android:textSize="7.5sp" android:textStyle="bold" />
    </LinearLayout>

    <View android:id="@+id/skin_header_divider" android:layout_width="0dp" android:layout_height="1dp" android:background="#243A2C" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/skin_top_bar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skin_header_divider">

        <LinearLayout
            android:id="@+id/skin_preview_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="7dp"
            android:layout_weight="0.40"
            android:background="@drawable/bg_skin_library_panel"
            android:orientation="vertical"
            android:padding="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:letterSpacing="0.08" android:text="LIVE 3D PREVIEW" android:textColor="#87A891" android:textSize="8sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_skin_status_chip" android:layout_width="wrap_content" android:layout_height="20dp" android:background="@drawable/bg_skin_slot_status" android:gravity="center" android:paddingHorizontal="7dp" android:text="ACTIVE" android:textColor="#BFE0C8" android:textSize="7sp" android:textStyle="bold" />
            </LinearLayout>
            <android.opengl.GLSurfaceView android:id="@+id/skin_preview_surface" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="5dp" android:layout_weight="1" />
            <TextView android:id="@+id/tv_preview_hint" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center" android:text="Drag to rotate • Pinch to zoom • Double-tap reset" android:textColor="#668070" android:textSize="8sp" />
            <TextView android:id="@+id/tv_skin_path" android:layout_width="match_parent" android:layout_height="28dp" android:ellipsize="middle" android:gravity="center" android:maxLines="1" android:textColor="#8FAB97" android:textSize="8sp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:layout_weight="0.60"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/skin_skin_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_skin_library_panel"
                    android:orientation="vertical"
                    android:padding="11dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SAVED SKINS" android:textColor="#E7F0EA" android:textSize="12sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap a card to preview • Use activates it" android:textColor="#688072" android:textSize="8sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/tv_cape_status_chip" android:layout_width="wrap_content" android:layout_height="20dp" android:background="@drawable/bg_skin_slot_status" android:gravity="center" android:paddingHorizontal="7dp" android:text="3 SLOTS" android:textColor="#A9C9B3" android:textSize="7sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/skin_slot_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:baselineAligned="false" android:orientation="horizontal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/skin_fetch_card"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_skin_library_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">
                    <EditText android:id="@+id/et_skin_username" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@drawable/bg_skin_slot_idle" android:hint="Fetch skin by Minecraft username" android:maxLines="1" android:paddingHorizontal="10dp" android:textColor="#DCE9E0" android:textColorHint="#617368" android:textSize="9.5sp" />
                    <Button android:id="@+id/btn_fetch_skin" android:layout_width="92dp" android:layout_height="36dp" android:layout_marginStart="7dp" android:background="@drawable/bg_skin_slot_action" android:text="FETCH" android:textColor="#CFE0D4" android:textSize="9sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/skin_cape_card"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_skin_library_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CAPE" android:textColor="#DDE9E1" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_cape_path" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="middle" android:maxLines="1" android:text="No cape selected" android:textColor="#688072" android:textSize="8sp" />
                    </LinearLayout>
                    <Button android:id="@+id/btn_change_cape" android:layout_width="76dp" android:layout_height="34dp" android:background="@drawable/bg_skin_slot_action" android:text="IMPORT" android:textColor="#CFE0D4" android:textSize="8sp" android:textStyle="bold" />
                    <Button android:id="@+id/btn_remove_cape" android:layout_width="68dp" android:layout_height="34dp" android:layout_marginStart="6dp" android:background="@drawable/bg_skin_slot_action" android:text="REMOVE" android:textColor="#A98487" android:textSize="8sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/skin_action_card"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_skin_library_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="9dp">
                    <Button android:id="@+id/btn_change_skin" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/bg_skin_slot_action" android:text="IMPORT / REPLACE" android:textColor="#D6E6DB" android:textSize="8.5sp" android:textStyle="bold" />
                    <Button android:id="@+id/btn_remove_skin" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:layout_weight="0.8" android:background="@drawable/bg_skin_slot_action" android:text="DELETE SLOT" android:textColor="#A98487" android:textSize="8.5sp" android:textStyle="bold" />
                    <Button android:id="@+id/btn_reset_default" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:layout_weight="0.8" android:background="@drawable/bg_skin_slot_action" android:text="RESET ALL" android:textColor="#9DB2A4" android:textSize="8.5sp" android:textStyle="bold" />
                    <Button android:id="@+id/btn_save_skin_changes" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:layout_weight="1" android:background="@drawable/bg_skin_slot_active" android:text="USE SELECTED" android:textColor="#E9F4EC" android:textSize="8.5sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:id="@+id/skin_status_card" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
