<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skin_studio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_skin_library_page">

    <LinearLayout
        android:id="@+id/skin_top_bar"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout android:id="@+id/skin_back_button" android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_skin_slot_action" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:contentDescription="Back" android:src="@drawable/ic_arrow_back" app:tint="#E4E4EA" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/skin_page_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.04" android:text="SKIN STUDIO" android:textColor="#F5F5F7" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/skin_page_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="Slot 1" android:textColor="#8B8D97" android:textSize="9sp" />
        </LinearLayout>
        <TextView android:id="@+id/tv_server_status_chip" android:layout_width="wrap_content" android:layout_height="26dp" android:background="@drawable/bg_skin_status_chip_active" android:gravity="center" android:paddingHorizontal="10dp" android:text="SYNC READY" android:textColor="#C9CBD6" android:textSize="7sp" android:textStyle="bold" />
    </LinearLayout>

    <View android:id="@+id/skin_header_divider" android:layout_width="0dp" android:layout_height="1dp" android:background="#292A31" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/skin_top_bar" />

    <LinearLayout
        android:id="@+id/skin_studio_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skin_header_divider">

        <LinearLayout
            android:id="@+id/skin_preview_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="7dp"
            android:layout_weight="0.42"
            android:background="@drawable/bg_skin_library_panel"
            android:orientation="vertical"
            android:padding="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:letterSpacing="0.1" android:text="LIVE 3D PREVIEW" android:textColor="#22C9CB" android:textSize="8sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_skin_status_chip" android:layout_width="wrap_content" android:layout_height="20dp" android:background="@drawable/bg_skin_slot_status" android:gravity="center" android:paddingHorizontal="7dp" android:text="ACTIVE" android:textColor="#C9CBD6" android:textSize="6.8sp" android:textStyle="bold" />
                <FrameLayout android:id="@+id/skin_preview_expand" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="6dp" android:background="@drawable/bg_skin_slot_action" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="⛶" android:textColor="#E4E4EA" android:textSize="14sp" />
                </FrameLayout>
            </LinearLayout>
            <FrameLayout android:id="@+id/skin_preview_inline_host" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="5dp" android:layout_weight="1" android:background="@drawable/bg_skin_slot_preview">
                <android.opengl.GLSurfaceView android:id="@+id/skin_preview_surface" android:layout_width="match_parent" android:layout_height="match_parent" />
            </FrameLayout>
            <TextView android:id="@+id/tv_preview_hint" android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center" android:text="Drag to rotate • Pinch to zoom • Double-tap reset" android:textColor="#777984" android:textSize="7.5sp" />
            <TextView android:id="@+id/tv_skin_path" android:layout_width="match_parent" android:layout_height="24dp" android:ellipsize="middle" android:gravity="center" android:maxLines="1" android:textColor="#9A9CA6" android:textSize="7.5sp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/skin_tools_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:layout_weight="0.58"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="4dp"
            android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <LinearLayout android:id="@+id/skin_skin_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_skin_library_panel" android:orientation="vertical" android:padding="10dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YOUR 3 SLOTS" android:textColor="#EDEDF1" android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap a slot to preview or switch" android:textColor="#777984" android:textSize="7.5sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/tv_cape_status_chip" android:layout_width="wrap_content" android:layout_height="20dp" android:background="@drawable/bg_skin_slot_status" android:gravity="center" android:paddingHorizontal="7dp" android:text="3 SLOTS" android:textColor="#C9CBD6" android:textSize="6.8sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/skin_slot_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:baselineAligned="false" android:orientation="horizontal" />
                </LinearLayout>

                <LinearLayout android:id="@+id/skin_fetch_card" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="9dp" android:background="@drawable/bg_skin_library_panel" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="10dp">
                    <EditText android:id="@+id/et_skin_username" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:background="@drawable/bg_skin_slot_idle" android:hint="Minecraft username" android:maxLines="1" android:paddingHorizontal="11dp" android:textColor="#EDEDF1" android:textColorHint="#777984" android:textSize="9sp" />
                    <Button android:id="@+id/btn_fetch_skin" android:layout_width="96dp" android:layout_height="38dp" android:layout_marginStart="7dp" android:background="@drawable/bg_skin_slot_action" android:minHeight="0dp" android:stateListAnimator="@null" android:text="FETCH USER" android:textColor="#E4E4EA" android:textSize="8sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:id="@+id/skin_cape_card" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="9dp" android:background="@drawable/bg_skin_library_panel" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="10dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CAPE" android:textColor="#EDEDF1" android:textSize="10sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tv_cape_path" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="middle" android:maxLines="1" android:text="No custom cape selected" android:textColor="#777984" android:textSize="7.5sp" />
                    </LinearLayout>
                    <Button android:id="@+id/btn_change_cape" android:layout_width="76dp" android:layout_height="36dp" android:background="@drawable/bg_skin_slot_action" android:minHeight="0dp" android:stateListAnimator="@null" android:text="IMPORT" android:textColor="#E4E4EA" android:textSize="7.5sp" android:textStyle="bold" />
                    <Button android:id="@+id/btn_remove_cape" android:layout_width="76dp" android:layout_height="36dp" android:layout_marginStart="6dp" android:background="@drawable/bg_skin_slot_action" android:minHeight="0dp" android:stateListAnimator="@null" android:text="REMOVE" android:textColor="#D08C92" android:textSize="7.5sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:id="@+id/skin_action_card" android:layout_width="match_parent" android:layout_height="62dp" android:layout_marginTop="9dp" android:background="@drawable/bg_skin_library_panel" android:gravity="center_vertical" android:orientation="horizontal" android:padding="9dp">
                    <Button android:id="@+id/btn_change_skin" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:background="@drawable/bg_skin_slot_action" android:minHeight="0dp" android:stateListAnimator="@null" android:text="IMPORT / REPLACE" android:textColor="#E4E4EA" android:textSize="7.5sp" android:textStyle="bold" />
                    <Button android:id="@+id/btn_remove_skin" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="6dp" android:layout_weight="0.78" android:background="@drawable/bg_skin_slot_action" android:minHeight="0dp" android:stateListAnimator="@null" android:text="DELETE" android:textColor="#D08C92" android:textSize="7.5sp" android:textStyle="bold" />
                    <Button android:id="@+id/btn_reset_default" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="6dp" android:layout_weight="0.82" android:background="@drawable/bg_skin_slot_action" android:minHeight="0dp" android:stateListAnimator="@null" android:text="RESET ALL" android:textColor="#B7B9C2" android:textSize="7.5sp" android:textStyle="bold" />
                    <Button android:id="@+id/btn_save_skin_changes" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="6dp" android:layout_weight="1.15" android:background="@drawable/bg_skin_slot_active" android:minHeight="0dp" android:stateListAnimator="@null" android:text="USE THIS SKIN" android:textColor="#F5F5F7" android:textSize="7.5sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:id="@+id/skin_status_card" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/skin_fullscreen_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="#F20B0B0E"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout android:id="@+id/skin_fullscreen_preview_host" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="14dp" android:background="@drawable/bg_skin_slot_preview" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="40dp" android:layout_gravity="top|start" android:layout_margin="22dp" android:background="@drawable/bg_skin_slot_status" android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.08" android:text="FULL 3D PREVIEW" android:textColor="#22C9CB" android:textSize="8sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="32dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="20dp" android:background="@drawable/bg_skin_slot_status" android:gravity="center" android:paddingHorizontal="14dp" android:text="Drag to rotate • Pinch to zoom • Double-tap reset" android:textColor="#C9CBD6" android:textSize="8sp" />
        <FrameLayout android:id="@+id/skin_fullscreen_close" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="top|end" android:layout_margin="22dp" android:background="@drawable/bg_skin_slot_action" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="×" android:textColor="#F5F5F7" android:textSize="22sp" />
        </FrameLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>