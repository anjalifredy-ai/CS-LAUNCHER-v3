<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_runtime_card"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">

        <!-- Icon tile -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_deck_icon_tile">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_cs_modpack"
                android:tint="#7BE8E0" />
        </FrameLayout>

        <!-- Main info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/version_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#F0F0F3"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="sodium-fabric-0.6.0" />

                <TextView
                    android:id="@+id/version_recommended_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_recommended"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:paddingHorizontal="7dp"
                    android:text="★ RECOMMENDED"
                    android:textColor="#FFFFFF"
                    android:textSize="7.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/version_mc_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_version_badge"
                    android:gravity="center"
                    android:paddingHorizontal="7dp"
                    android:textColor="#7BE8E0"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="1.21.1" />

                <TextView
                    android:id="@+id/version_compat_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_badge_compat_ok"
                    android:gravity="center"
                    android:paddingHorizontal="7dp"
                    android:text="✓ Compatible"
                    android:textColor="#9FD6AC"
                    android:textSize="7.5sp"
                    android:textStyle="bold"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/version_loader_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_stat_chip"
                    android:gravity="center"
                    android:paddingHorizontal="7dp"
                    android:text="Fabric"
                    android:textColor="#B8BCC8"
                    android:textSize="7.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="#5A5E6E" />
    </LinearLayout>
</FrameLayout>
