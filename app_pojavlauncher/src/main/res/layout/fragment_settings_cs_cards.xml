<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 6 SETTINGS 4 cards — CS Plus master prompt -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg_pure_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cs_settings_title"
            android:textColor="@color/cs_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cs_settings_sub"
            android:textColor="@color/cs_text_secondary"
            android:textSize="11sp" />

        <!-- Java Tweaks -->
        <LinearLayout
            android:id="@+id/cs_set_java"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/cs_bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_settings_java_tweaks"
                android:textColor="@color/cs_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/cs_settings_java_tweaks_desc"
                android:textColor="@color/cs_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Misc -->
        <LinearLayout
            android:id="@+id/cs_set_misc"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/cs_bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_settings_misc"
                android:textColor="@color/cs_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/cs_settings_misc_desc"
                android:textColor="@color/cs_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Video -->
        <LinearLayout
            android:id="@+id/cs_set_video"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/cs_bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_settings_video"
                android:textColor="@color/cs_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/cs_settings_video_desc"
                android:textColor="@color/cs_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Experimental -->
        <LinearLayout
            android:id="@+id/cs_set_experimental"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/cs_bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cs_settings_experimental"
                android:textColor="@color/cs_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/cs_settings_experimental_desc"
                android:textColor="@color/cs_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
