<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_csc_screen">
 <ImageView android:layout_width="260dp" android:layout_height="260dp" android:layout_gravity="center" android:alpha="0.025" android:src="@drawable/cs_logo"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="16dp">
  <LinearLayout android:id="@+id/csc_builder_identity" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.34" android:background="@drawable/bg_csc_panel" android:orientation="vertical" android:padding="18dp">
   <TextView android:includeFontPadding="false" android:id="@+id/csc_builder_back" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_csc_outline_button" android:gravity="center" android:text="‹" android:textColor="#F2F3F5" android:textSize="28sp"/>
   <ImageView android:layout_width="76dp" android:layout_height="76dp" android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" android:src="@drawable/cs_logo"/>
   <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="CS CLIENT" android:textColor="#F2F3F5" android:textSize="19sp" android:textStyle="bold"/>
   <TextView android:includeFontPadding="false" android:id="@+id/csc_builder_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:textColor="#BCC3CC" android:textSize="10sp" android:textStyle="bold"/>
   <TextView android:includeFontPadding="false" android:id="@+id/csc_builder_build" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:textColor="#7F8994" android:textSize="7sp"/>
   <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
   <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="38dp" android:background="@drawable/bg_csc_manifest_row" android:gravity="center" android:text="●  READY" android:textColor="#62D99B" android:textSize="9sp" android:textStyle="bold"/>
   <TextView android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="ATOMIC INSTALL • VERIFIED FILES\nROLLBACK SAFE" android:textColor="#68737E" android:textSize="6sp"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/csc_builder_manifest" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="14dp" android:layout_weight="0.66" android:background="@drawable/bg_csc_panel" android:orientation="vertical" android:padding="16dp">
   <TextView android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BUILD MANIFEST" android:textColor="#F2F3F5" android:textSize="18sp" android:textStyle="bold"/>
   <TextView android:includeFontPadding="false" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="SELECT MODULES • ONE MODPACK MAXIMUM" android:textColor="#7F8994" android:textSize="7sp"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:orientation="horizontal">
    <TextView android:includeFontPadding="false" android:id="@+id/csc_browse_mods" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_csc_outline_button" android:drawableStart="@drawable/ic_cs_mods" android:drawablePadding="10dp" android:gravity="center" android:text="BROWSE MODS   ›" android:textColor="#F2F3F5" android:textSize="10sp" android:textStyle="bold"/>
    <TextView android:includeFontPadding="false" android:id="@+id/csc_browse_pack" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/bg_csc_outline_button" android:drawableStart="@drawable/ic_cs_modpack" android:drawablePadding="10dp" android:gravity="center" android:text="SELECT MODPACK   ›" android:textColor="#F2F3F5" android:textSize="10sp" android:textStyle="bold"/>
   </LinearLayout>
   <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1" android:overScrollMode="never" android:scrollbars="none"><LinearLayout android:id="@+id/csc_selection_chips" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/></ScrollView>
   <TextView android:includeFontPadding="false" android:id="@+id/csc_create_profile" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/bg_csc_primary_button" android:gravity="center" android:text="CREATE CS CLIENT PROFILE" android:textColor="#101419" android:textSize="10sp" android:textStyle="bold"/>
  </LinearLayout>
 </LinearLayout>
</FrameLayout>