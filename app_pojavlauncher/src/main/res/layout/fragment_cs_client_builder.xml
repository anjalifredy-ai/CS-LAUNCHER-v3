<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0B0C10" android:orientation="vertical">

    <LinearLayout android:id="@+id/csc_builder_header" android:layout_width="match_parent"
        android:layout_height="78dp" android:background="@drawable/bg_cs_client_header"
        android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp">
        <ImageView android:layout_width="44dp" android:layout_height="44dp"
            android:background="@drawable/bg_cs_client_icon" android:padding="7dp" android:src="@drawable/cs_logo"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/csc_builder_eyebrow" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#22C9CB" android:textSize="9sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:text="Build your CS Client profile"
                android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
            <TextView android:id="@+id/csc_builder_core" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#9698A0" android:textSize="8sp"/>
        </LinearLayout>
        <TextView android:id="@+id/csc_builder_back" android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/bg_skin_slot_action" android:gravity="center"
            android:text="‹" android:textColor="#FFFFFF" android:textSize="28sp"/>
    </LinearLayout>

    <ScrollView android:id="@+id/csc_builder_scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:overScrollMode="never" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal">
                <LinearLayout android:id="@+id/csc_browse_mods" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="@drawable/bg_cs_client_transparent"
                    android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_cs_client_icon"
                        android:padding="7dp" android:src="@drawable/ic_cs_mods"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BROWSE MODS"
                            android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Multiple selection"
                            android:textColor="#888A93" android:textSize="8sp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/csc_browse_pack" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/bg_cs_client_transparent"
                    android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_cs_client_icon"
                        android:padding="7dp" android:src="@drawable/ic_cs_modpack"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MODPACK"
                            android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Maximum one"
                            android:textColor="#888A93" android:textSize="8sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp"
                android:text="CURRENT SELECTION" android:textColor="#22C9CB" android:textSize="9sp" android:textStyle="bold"/>
            <LinearLayout android:id="@+id/csc_selection_chips" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical"/>
            <TextView android:id="@+id/csc_install_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center"
                android:textColor="#D0D0D0" android:textSize="10sp"/>
            <net.kdt.pojavlaunch.csclient.CsClientInstallView android:id="@+id/csc_install_visual"
                android:layout_width="match_parent" android:layout_height="300dp" android:layout_marginTop="4dp"
                android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>
    <TextView android:id="@+id/csc_create_profile" android:layout_width="match_parent" android:layout_height="50dp"
        android:layout_marginHorizontal="14dp" android:layout_marginBottom="12dp"
        android:background="@drawable/bg_skin_button_primary" android:gravity="center"
        android:text="CREATE CS CLIENT PROFILE" android:textColor="#101014" android:textSize="11sp" android:textStyle="bold"/>
</LinearLayout>