<?xml version="1.0" encoding="utf-8"?>
<!-- V3.1 — CS CLIENT BUILDER — completely new design, dark white black, researched premium glass -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D11">

    <!-- subtle white aura top -->
    <View
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:background="@drawable/bg_runtime_setup_page"
        android:alpha="0.6" />

    <!-- tiny watermark -->
    <ImageView
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center"
        android:alpha="0.02"
        android:src="@drawable/cs_logo" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Identity header — full width, new position (top, not side) -->
            <LinearLayout
                android:id="@+id/csc_builder_identity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_csc_panel"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="18dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/csc_builder_back"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="#FFFFFF"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="#0B0D11"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/cs_logo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:letterSpacing="0.14"
                            android:text="CS CLIENT"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_stat_chip"
                            android:gravity="center"
                            android:paddingHorizontal="7dp"
                            android:text="V3.1"
                            android:textColor="#FFFFFF"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="#14161E" />
                </FrameLayout>

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:src="@drawable/cs_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:letterSpacing="0.02"
                    android:text="CS CLIENT"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="CS CLIENT" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"
                    android:letterSpacing="0.1"
                    android:text="V3.1 • ATOMIC BUILDER"
                    android:textColor="#8E959E"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/csc_builder_version"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_badge_compat_ok"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        tools:text="MINECRAFT 1.21.1" />

                    <TextView
                        android:id="@+id/csc_builder_build"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_stat_chip"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        tools:text="BLAZE 1.4 • FABRIC" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_badge_online"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="●  READY • V3.1"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:text="ATOMIC INSTALL • VERIFIED FILES • ROLLBACK SAFE"
                    android:textColor="#5A636E"
                    android:textSize="6.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Manifest — full width below identity, new position -->
            <LinearLayout
                android:id="@+id/csc_builder_manifest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_csc_panel"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="14dp"
                        android:background="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:letterSpacing="0.1"
                        android:text="BUILD MANIFEST"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_stat_chip"
                        android:gravity="center"
                        android:paddingHorizontal="7dp"
                        android:text="V3.1"
                        android:textColor="#FFFFFF"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:letterSpacing="0.08"
                    android:text="SELECT MODULES • ONE MODPACK MAXIMUM"
                    android:textColor="#7F8894"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/csc_browse_mods"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_csc_primary_button"
                        android:drawableStart="@drawable/ic_cs_mods"
                        android:drawablePadding="8dp"
                        android:drawableTint="#0B0D11"
                        android:gravity="center"
                        android:text="BROWSE MODS"
                        android:textColor="#0B0D11"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/csc_browse_pack"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_csc_outline_button"
                        android:drawableStart="@drawable/ic_cs_modpack"
                        android:drawablePadding="8dp"
                        android:drawableTint="#FFFFFF"
                        android:gravity="center"
                        android:text="SELECT MODPACK"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="#1E242E" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:letterSpacing="0.08"
                    android:text="SELECTED MODULES"
                    android:textColor="#9AA3B0"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/csc_selection_chips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/csc_create_profile"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_csc_primary_button"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:letterSpacing="0.06"
                    android:text="CREATE CS CLIENT PROFILE — V3.1"
                    android:textColor="#0B0D11"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Isolated profile • Atomic • Verified"
                    android:textColor="#5A636E"
                    android:textSize="7sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
