<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg_pure_black"
    android:orientation="vertical">

    <include layout="@layout/cs_top_app_bar"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MANAGE CONTENT / MODS"
            android:textColor="@color/cs_text_primary"
            android:textStyle="bold"
            android:textSize="14sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tab_mods"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Mods"
            android:textColor="@color/cs_brand_green"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tab_resource_packs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="Resource Packs"
            android:textColor="@color/cs_text_secondary"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tab_shaders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shaders"
            android:textColor="@color/cs_text_secondary"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/edit_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Search installed mods..."
            android:textColorHint="@color/cs_text_tertiary"
            android:textColor="@color/cs_text_primary"
            android:background="@drawable/cs_card_bg"
            android:padding="10dp"
            android:textSize="11sp"
            android:singleLine="true"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/btn_browse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Browse"
            android:background="@drawable/cs_btn_primary_bg"
            android:textColor="@color/cs_text_on_brand"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textStyle="bold"
            android:textSize="11sp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_installed"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp"/>
</LinearLayout>
