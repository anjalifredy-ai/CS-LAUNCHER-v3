<?xml version="1.0" encoding="utf-8"?>
<!-- PREMIUM V4 — Download Console redesign
     Floating glass deck: accent top rail • 46dp icon tile • title + big % • pills • 8dp luminous beam • segmented controls • mini-pill -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clickable="false"
    android:focusable="false">

    <!-- ─────────── Expanded deck ─────────── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/download_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_download_console"
        android:elevation="16dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="0dp"
        android:paddingBottom="14dp"
        app:layout_constraintWidth_max="680dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Accent top rail -->
        <View
            android:layout_width="0dp"
            android:layout_height="2.2dp"
            android:background="#7BE8E0"
            android:alpha="0.9"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Icon tile -->
        <FrameLayout
            android:id="@+id/progress_icon_wrap"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_deck_icon_tile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/progress_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_download"
                android:tint="#FFFFFF"
                tools:ignore="UseAppTint" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/progress_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.015"
            android:maxLines="1"
            android:textColor="#F1F1F4"
            android:textSize="13.5sp"
            app:layout_constraintStart_toEndOf="@id/progress_icon_wrap"
            app:layout_constraintEnd_toStartOf="@id/progress_percentage_text"
            app:layout_constraintTop_toTopOf="@id/progress_icon_wrap"
            tools:text="Downloading Sodium 0.6.0" />

        <!-- Big percentage -->
        <TextView
            android:id="@+id/progress_percentage_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.03"
            android:textColor="#F6F6F9"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/progress_icon_wrap"
            tools:text="42%" />

        <!-- Paused / status chip -->
        <TextView
            android:id="@+id/progress_paused_badge"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_runtime_chip_recommended"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="⏸ PAUSED"
            android:textColor="#D8C79A"
            android:textSize="8sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/progress_status_text"
            app:layout_constraintTop_toBottomOf="@id/progress_status_text"
            tools:visibility="visible" />

        <!-- Detail line -->
        <TextView
            android:id="@+id/progress_detail_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#9FA3B0"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="@id/progress_status_text"
            app:layout_constraintEnd_toStartOf="@id/progress_percentage_text"
            app:layout_constraintTop_toBottomOf="@id/progress_status_text"
            tools:text="141.2 MB / 513 MB" />

        <!-- Meta row: speed + ETA as subtle chips -->
        <LinearLayout
            android:id="@+id/progress_meta_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@id/progress_status_text"
            app:layout_constraintEnd_toStartOf="@id/progress_percentage_text"
            app:layout_constraintTop_toBottomOf="@id/progress_detail_text">

            <TextView
                android:id="@+id/progress_speed_text"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:background="@drawable/bg_stat_chip"
                android:gravity="center"
                android:paddingHorizontal="7dp"
                android:textColor="#E2E4EA"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                tools:text="2.5 MB/s"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/progress_eta_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#7C8190"
                android:textSize="10.5sp"
                android:visibility="gone"
                tools:text="• 1m 20s remaining"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Premium 8dp luminous beam -->
        <com.kdt.mcgui.DownloadAssemblyBar
            android:id="@+id/progress_horizontal_bar"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginTop="14dp"
            android:max="100"
            android:progress="42"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progress_meta_row" />

        <!-- Controls: segmented -->
        <LinearLayout
            android:id="@+id/progress_controls_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progress_horizontal_bar">

            <LinearLayout
                android:id="@+id/progress_btn_pause"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1.45"
                android:background="@drawable/bg_console_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/progress_btn_pause_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_pause"
                    android:tint="#E8EAEE" />

                <TextView
                    android:id="@+id/progress_btn_pause_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:letterSpacing="0.04"
                    android:text="PAUSE"
                    android:textColor="#E8EAEE"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="8dp"
                android:layout_height="36dp" />

            <LinearLayout
                android:id="@+id/progress_btn_stop"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="0.85"
                android:background="@drawable/bg_console_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_stop_square"
                    android:tint="#9FA3B0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="STOP"
                    android:textColor="#9FA3B0"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="8dp"
                android:layout_height="36dp" />

            <LinearLayout
                android:id="@+id/progress_btn_hide"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_console_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="#7C8190" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ─────────── Collapsed mini-pill ─────────── -->
    <LinearLayout
        android:id="@+id/console_pill"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_console_pill"
        android:elevation="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_download_trend"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/console_pill_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#F0F0F3"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="42%" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_chevron_up"
            android:tint="#7C8190" />
    </LinearLayout>

    <!-- ─────────── Legacy compatibility (hidden) ─────────── -->
    <FrameLayout
        android:id="@+id/progress_indicator_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.kdt.mcgui.PulseOrbitView
            android:id="@+id/pulse_orbit"
            android:layout_width="0dp"
            android:layout_height="0dp" />
    </FrameLayout>

    <com.kdt.mcgui.KineticProgressView
        android:id="@+id/kinetic_progress_legacy"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/progress_textview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/progress_flip_arrow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/progress_linear_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
