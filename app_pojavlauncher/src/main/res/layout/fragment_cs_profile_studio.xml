<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cs_bg_pure_black"
    android:orientation="vertical">

    <include layout="@layout/cs_top_app_bar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/cs_card_bg">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/cs_banner_overlay"/>

                <TextView
                    android:id="@+id/btn_change_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="10dp"
                    android:text="CHANGE BACKGROUND"
                    android:background="@drawable/cs_chip_outline_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:textColor="@color/cs_text_primary"
                    android:textStyle="bold"
                    android:textSize="9sp"/>
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile Studio"
                android:textColor="@color/cs_text_secondary"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/txt_profile_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Fabric 1.20.1"
                android:textColor="@color/cs_text_primary"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/cs_card_bg"
                    android:padding="8dp">

                    <LinearLayout
                        android:id="@+id/tab_general"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp"
                        android:background="@drawable/cs_card_bg_selected">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="GEN" android:textColor="@color/cs_brand_green"
                            android:textStyle="bold" android:textSize="11sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tab_java"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp"
                        android:layout_marginTop="4dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="JAVA" android:textColor="@color/cs_text_secondary"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical"
                    android:background="@drawable/cs_card_bg"
                    android:padding="16dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="GENERAL" android:textColor="@color/cs_text_primary"
                        android:textStyle="bold" android:textSize="13sp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:text="NAME"
                        android:textColor="@color/cs_text_secondary" android:textSize="10sp"
                        android:textAllCaps="true"/>

                    <EditText
                        android:id="@+id/edit_profile_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Fabric 1.20.1"
                        android:background="@drawable/cs_card_bg"
                        android:padding="12dp"
                        android:textColor="@color/cs_text_primary"
                        android:textSize="13sp"
                        android:singleLine="true"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:text="VERSION"
                        android:textColor="@color/cs_text_secondary" android:textSize="10sp"
                        android:textAllCaps="true"/>

                    <TextView
                        android:id="@+id/txt_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="fabric-loader-0.19.5-1.20.1"
                        android:textColor="@color/cs_text_primary"
                        android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="end"
        android:background="@color/cs_bg_pure_black">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="CANCEL"
            android:background="@drawable/cs_btn_outline_bg"
            android:textColor="@color/cs_text_primary"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textStyle="bold"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="SAVE"
            android:background="@drawable/cs_btn_primary_bg"
            android:textColor="@color/cs_text_on_brand"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textStyle="bold"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/btn_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DELETE"
            android:background="@drawable/cs_btn_danger_bg"
            android:textColor="@color/cs_danger_red"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textStyle="bold"
            android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
