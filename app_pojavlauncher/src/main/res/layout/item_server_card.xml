<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_server_card"
    android:elevation="1dp"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_deck_icon_tile">

            <ImageView
                android:id="@+id/server_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_globe" />

            <View
                android:id="@+id/server_online_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="2dp"
                android:background="@drawable/bg_server_online_dot"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/server_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    tools:text="Hypixel • 1.21" />

                <!-- Minecraft-style ping with 5 bars + ms -->
                <LinearLayout
                    android:id="@+id/server_ping_container"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:id="@+id/server_ping_bars"
                        android:layout_width="wrap_content"
                        android:layout_height="12dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <View android:id="@+id/ping_bar_1" android:layout_width="3dp" android:layout_height="3dp" android:layout_marginEnd="1dp" android:background="#5A636E" />
                        <View android:id="@+id/ping_bar_2" android:layout_width="3dp" android:layout_height="5dp" android:layout_marginEnd="1dp" android:background="#5A636E" />
                        <View android:id="@+id/ping_bar_3" android:layout_width="3dp" android:layout_height="7dp" android:layout_marginEnd="1dp" android:background="#5A636E" />
                        <View android:id="@+id/ping_bar_4" android:layout_width="3dp" android:layout_height="9dp" android:layout_marginEnd="1dp" android:background="#5A636E" />
                        <View android:id="@+id/ping_bar_5" android:layout_width="3dp" android:layout_height="12dp" android:background="#5A636E" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/server_ping"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="#9AA3B0"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        tools:text="42 ms" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/server_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#7F8894"
                android:textSize="10sp"
                tools:text="mc.hypixel.net:25565" />

            <TextView
                android:id="@+id/server_motd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#EDEEF2"
                android:textSize="11.5sp"
                tools:text="Hypixel Network [1.8-1.21] NEW GAME!" />
        </LinearLayout>

        <TextView
            android:id="@+id/server_players"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_compat_ok"
            android:gravity="center"
            android:minWidth="54dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="142/500" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#1E242E" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/server_version"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/bg_stat_chip"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:visibility="gone"
            tools:text="1.21.1" />

        <TextView
            android:id="@+id/server_offline_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Offline"
            android:textColor="#FF6B6B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/server_btn_remove"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_csc_outline_button"
            android:gravity="center"
            android:text="×"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/server_btn_join"
            android:layout_width="96dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_csc_primary_button"
            android:elevation="2dp"
            android:gravity="center"
            android:text="PLAY"
            android:textColor="#0B0D11"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
