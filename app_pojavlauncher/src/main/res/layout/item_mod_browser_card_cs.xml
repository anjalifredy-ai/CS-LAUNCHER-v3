<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/cs_card_bg"
    android:padding="12dp"
    android:layout_margin="4dp">

    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/cs_card_bg"
        android:gravity="center">

        <TextView
            android:id="@+id/txt_mod_letter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FA"
            android:textColor="@color/cs_brand_green"
            android:textStyle="bold"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/txt_mod_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fabric API"
        android:textColor="@color/cs_text_primary"
        android:textStyle="bold"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/txt_mod_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="by modmuss"
        android:textColor="@color/cs_text_secondary"
        android:textSize="9sp"/>

    <TextView
        android:id="@+id/txt_mod_downloads"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="1.2M"
        android:textColor="@color/cs_brand_green"
        android:textSize="10sp"/>

    <TextView
        android:id="@+id/btn_download"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="INSTALL"
        android:background="@drawable/cs_btn_primary_bg"
        android:textColor="@color/cs_text_on_brand"
        android:padding="6dp"
        android:textSize="10sp"
        android:textStyle="bold"/>
</LinearLayout>
