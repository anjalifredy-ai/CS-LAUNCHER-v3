<?xml version="1.0" encoding="utf-8"?>
<!--
     Ely.by Login — premium dark glass card with ScrollView wrapper
     Landscape / horizontal launcher friendly, keyboard safe
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_elyby_page"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="@dimen/_16sdp">

            <LinearLayout
                android:id="@+id/card_elyby_login"
                android:layout_width="@dimen/_280sdp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_elyby_card"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="@dimen/_18sdp">

                <!-- Brand header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/_14sdp">

                    <!-- Icon well -->
                    <FrameLayout
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="@dimen/_48sdp"
                        android:background="@drawable/bg_elyby_icon_well"
                        android:elevation="2dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_elyby_icon_glow" />

                        <ImageView
                            android:layout_width="@dimen/_28sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:layout_gravity="center"
                            android:contentDescription="Ely.by"
                            android:src="@drawable/ic_auth_elyby" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:text="ELY.BY ACCOUNT"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/_14ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:text="Multiplayer skins &amp; community authentication"
                        android:textColor="#9E98A6"
                        android:textSize="@dimen/_9ssp" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="@dimen/_14sdp"
                    android:background="@drawable/bg_elyby_divider" />

                <!-- Username / Email -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="USERNAME OR EMAIL"
                        android:textColor="#D4CDDD"
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/login_edit_email"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:background="@drawable/bg_elyby_input"
                    android:hint="user@ely.by"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#5A5560"
                    android:textSize="@dimen/_13ssp" />

                <!-- Password -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="PASSWORD"
                        android:textColor="#D4CDDD"
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/login_edit_password"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_marginBottom="@dimen/_14sdp"
                    android:background="@drawable/bg_elyby_input"
                    android:hint="••••••••"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#5A5560"
                    android:textSize="@dimen/_13ssp" />

                <!-- Login CTA -->
                <TextView
                    android:id="@+id/login_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_40sdp"
                    android:background="@drawable/bg_elyby_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:foreground="@drawable/bg_elyby_button_ripple"
                    android:gravity="center"
                    android:letterSpacing="0.12"
                    android:text="LOGIN"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />

                <!-- Open Ely.by Website in Browser (WebView like Microsoft) -->
                <TextView
                    android:id="@+id/btn_open_elyby_browser"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@drawable/bg_settings_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🌐 OPEN ELY.BY IN BROWSER (LIKE MICROSOFT)"
                    android:textAllCaps="true"
                    android:textColor="#EDEDF2"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <!-- Footer note -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.15"
                    android:text="Credentials are sent securely to Ely.by"
                    android:textColor="#6B6570"
                    android:textSize="@dimen/_9ssp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
