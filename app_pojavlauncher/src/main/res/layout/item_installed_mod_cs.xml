<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/cs_card_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/cs_card_bg"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="M"
            android:textColor="@color/cs_brand_green"
            android:textStyle="bold"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_mod_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mod name"
            android:textColor="@color/cs_text_primary"
            android:textStyle="bold"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/txt_mod_file"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="mod.jar"
            android:textColor="@color/cs_text_secondary"
            android:textSize="9sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/badge_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:text="Enabled"
        android:background="@drawable/cs_chip_outline_bg"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="@color/cs_brand_green"
        android:textStyle="bold"
        android:textSize="9sp"/>

    <Switch
        android:id="@+id/switch_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"/>
</LinearLayout>
