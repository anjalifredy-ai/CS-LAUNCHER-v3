<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <ScrollView
        android:id="@+id/sd_console_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#050B14"
        android:fillViewport="true"
        android:padding="8dp">
        <TextView
            android:id="@+id/sd_console_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Console idle. Start server to see logs."
            android:textColor="#9FE870"
            android:textSize="11sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/sd_console_input"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_remom_tile"
            android:hint="say hello / op Player / stop"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="#F0F6FF"
            android:textColorHint="#5A7A98"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/sd_console_send"
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_remom_play"
            android:gravity="center"
            android:text="SEND"
            android:textColor="#FFF"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
